{
  "expo": {
    "name": "MYEZ",
    "slug": "qaren",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "qaren",
    "locales": {
      "en": "./locales/en.json",
      "ar": "./locales/ar.json"
    },
    "ios": {
      "bundleIdentifier": "com.qaren.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:getmyez.com"],
      "privacyManifests": {
