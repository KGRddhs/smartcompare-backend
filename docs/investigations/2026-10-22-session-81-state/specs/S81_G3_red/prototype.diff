+"""S81-17 KB-INGEST + D05 FIELD-STATUS (PROTOTYPE, the RED round; thrown away)."""
+import copy
+import logging
+import math
+import os
+import re
+import time
+from datetime import datetime, timezone
+from decimal import Decimal, InvalidOperation
+from typing import Any, Dict, List, Optional
+
+from app.services import deny_hosts, jsonld_widen
+from app.services import result_gate as _rg
+
+logger = logging.getLogger(__name__)
+
+KB_PRODUCTS_TABLE = "kb_products"
+KB_VARIANTS_TABLE = "kb_variants"
+KB_OFFERS_TABLE = "kb_offers"
+KB_IMAGES_TABLE = "kb_images"
+KB_REVIEWS_TABLE = "kb_reviews"
+KB_GAPS_TABLE = "kb_gaps"
+
+_TRUTHY = ("true", "1", "yes", "on")
+D05_FIELDS = ("identity", "image", "price", "size", "concentration", "specs", "rating",
+              "review_count")
+_PAGE_EVIDENCE = frozenset({"page_scrape", "page_scrape_jsonld", "local_bhd"})
+_PLATFORM_API = frozenset({"shopify_json", "woo_store_api", "salla_api", "occ_rest_bhd",
+                           "magento_graphql_bhd", "rest_json_bhd"})
+_ML_RE = re.compile(r"^\s*(\d{1,5})\s*ml\s*$", re.IGNORECASE)
+
+
+def kb_ingest_enabled() -> bool:
+    return os.getenv("ENABLE_KB_INGEST", "false").strip().lower() in _TRUTHY
+
+
+def field_status_metadata_enabled() -> bool:
+    return os.getenv("ENABLE_FIELD_STATUS_METADATA", "false").strip().lower() in _TRUTHY
+
+
+def _gap_max() -> int:
+    raw = os.getenv("KB_INGEST_GAP_MAX")
+    if raw is None:
+        return 16
+    try:
+        value = float(str(raw).strip())
+    except (TypeError, ValueError):
+        return 16
+    if not math.isfinite(value) or value <= 0:
+        return 16
+    return int(min(max(value, 1), 64))
+
+
+def _now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def _admin_client():
+    from app.services.database_service import get_admin_supabase_client
+    return get_admin_supabase_client()
+
+
+def kb_leaf():
+    from app.services import kb_service as _kb
+    return _kb
+
+
+def rung_for(method: Any) -> Optional[str]:
+    if method in _PAGE_EVIDENCE:
+        return "page_evidence"
+    if method in _PLATFORM_API:
+        return "platform_api"
+    return None
+
+
+def _z(moment: Any) -> Optional[str]:
+    if not isinstance(moment, datetime):
+        return None
+    aware = moment if moment.tzinfo else moment.replace(tzinfo=timezone.utc)
+    return aware.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def _na(value: Any) -> bool:
+    return _rg._is_na(value)
+
+
+def _tier3(specs: Dict[str, Any]) -> set:
+    return _rg._tier3_fields(specs) if isinstance(specs, dict) else set()
+
+
+def _item(state, source=None, reason=None):
+    return {"state": state, "source": source, "reason": reason}
+
+
+def _size_ml(price: Any) -> Optional[int]:
+    if not isinstance(price, dict):
+        return None
+    m = _ML_RE.match(str(price.get("size") or ""))
+    if not m:
+        return None
+    ml = int(m.group(1))
+    return ml if 1 <= ml <= 9999 else None
+
+
+def _status_one(p: Dict[str, Any], captured_at: Any, vision: bool) -> Dict[str, Any]:
+    from app.services.price_service import OFFICIAL_BRAND_DOMAINS
+
+    kb = kb_leaf()
+    price = p.get("price") if isinstance(p.get("price"), dict) else {}
+    specs = p.get("specs") if isinstance(p.get("specs"), dict) else {}
+    t3 = _tier3(specs)
+    out: Dict[str, Any] = {}
+    id_source = "vision" if vision else "parse"
+    if _rg.product_is_placeholder({"brand": p.get("brand"), "name": p.get("name")}):
+        out["identity"] = _item("unknown", id_source, "placeholder_identity")
+    elif kb.kb_product_id(p.get("brand") or "", p.get("name") or "", p.get("variant")) is None:
+        out["identity"] = _item("unknown", id_source, "no_product_id")
+    else:
+        out["identity"] = _item("known", id_source)
+    served = p.get("image_url")
+    if isinstance(served, str) and served.strip().lower().startswith("https://"):
+        page_img = price.get("image_url")
+        ok = (served == page_img and jsonld_widen.allowed_image_url(
+            page_img, price.get("url"), OFFICIAL_BRAND_DOMAINS) is not None)
+        out["image"] = _item("known", "retailer_page" if ok else "search")
+    else:
+        out["image"] = _item("unknown", None, "no_image")
+    if _rg.price_is_showable(price):
+        host = deny_hosts.normalize_host(jsonld_widen._url_host(price.get("url"))) or None
+        rung = rung_for(price.get("source_method"))
+        if price.get("_cached") is False:
+            item = dict(_item("fresh", host), as_of=_z(captured_at), rung=rung)
+        elif price.get("_cached") is True:
+            item = dict(_item("stale", host, "served_from_cache"), as_of=None, rung=rung)
+        else:
+            item = dict(_item("stale", host, "unmarked"), as_of=None, rung=rung)
+    else:
+        est = price.get("estimated") is True or price.get("source_method") == "estimated"
+        item = dict(_item("unknown", None, "estimated" if est else "no_price"), as_of=None,
+                    rung=None)
+    out["price"] = item
+    if _size_ml(price) is not None:
+        out["size"] = _item("known", "listing")
+    elif not _na(specs.get("volume")) and "volume" not in t3:
+        out["size"] = _item("known", "specs")
+    elif not _na(specs.get("volume")):
+        out["size"] = _item("unknown", None, "model_knowledge")
+    else:
+        out["size"] = _item("unknown", None, "no_size")
+    conc = specs.get("concentration")
+    if not _na(conc) and "concentration" not in t3:
+        out["concentration"] = _item("known", "specs")
+    elif not _na(conc):
+        out["concentration"] = _item("unknown", None, "model_knowledge")
+    else:
+        out["concentration"] = _item("unknown", None, "no_concentration")
+    real = [k for k, v in specs.items() if not str(k).startswith("_") and not _na(v)]
+    if [k for k in real if k not in t3]:
+        out["specs"] = _item("known", "search")
+    elif real:
+        out["specs"] = _item("unknown", None, "model_knowledge")
+    else:
+        out["specs"] = _item("unknown", None, "no_specs")
+    rsrc = "retailer_jsonld" if isinstance(p.get("jsonld_rating"), dict) else "provider"
+    if _rg.rating_is_real(p):
+        out["rating"] = _item("known", rsrc)
+    elif p.get("rating_derived") is True:
+        out["rating"] = _item("unknown", None, "derived_rating")
+    else:
+        out["rating"] = _item("unknown", None, "no_rating")
+    rc = p.get("review_count")
+    if isinstance(rc, int) and not isinstance(rc, bool) and rc > 0:
+        out["review_count"] = _item("known", rsrc)
+    else:
+        out["review_count"] = _item("unknown", None, "no_review_count")
+    return out
+
+
+def field_status(product_data: Any, result: Any, *, captured_at: Any, vision: bool = False
+                 ) -> List[Dict[str, Any]]:
+    products = list(product_data or [])[:2]
+    return [_status_one(p if isinstance(p, dict) else {}, captured_at, vision) for p in products]
+
+
+def build_job(result: Any, product_data: Any, *, product_categories: Any, region: Any,
+              vision: Any, captured_at: Any) -> Dict[str, Any]:
+    assessment = _rg.assess_result(result, product_categories=product_categories)
+    fs = field_status(product_data, result, captured_at=captured_at, vision=bool(vision))
+    products = []
+    for p, f in zip(list(product_data or [])[:2], fs):
+        p = p if isinstance(p, dict) else {}
+        price = p.get("price") if isinstance(p.get("price"), dict) else {}
+        products.append({
+            "brand": p.get("brand"), "name": p.get("name"), "variant": p.get("variant"),
+            "category": p.get("category"),
+            "price": {k: copy.deepcopy(price.get(k)) for k in (
+                "amount", "currency", "url", "source_method", "estimated", "_cached", "size",
+                "image_url", "in_stock")},
+            "jsonld_facts": copy.deepcopy(price.get("_jsonld_facts"))
+            if isinstance(price.get("_jsonld_facts"), dict) else None,
+            "jsonld_rating": copy.deepcopy(p.get("jsonld_rating"))
+            if isinstance(p.get("jsonld_rating"), dict) else None,
+            "field_status": copy.deepcopy(f),
+        })
+    return {"captured_at": captured_at, "region": region,
+            "identity_confidence": assessment.get("identity_confidence"),
+            "products": products, "field_status": copy.deepcopy(fs)}
+
+
+def _record_for(records: Dict[str, Any], host: str) -> Optional[Dict[str, Any]]:
+    if not host or not isinstance(records, dict):
+        return None
+    if host in records:
+        return records[host]
+    best = None
+    for key in records:
+        if host.endswith("." + key) and (best is None or len(key) > len(best)):
+            best = key
+    return records[best] if best is not None else None
+
+
+def _norm(col: str, value: Any) -> str:
+    if col == "amount":
+        try:
+            return str(Decimal(str(value)).normalize())
+        except (InvalidOperation, ValueError):
+            return str(value)
+    return str(value)
+
+
+def _key(row: Dict[str, Any], cols) -> tuple:
+    return tuple(_norm(c, row.get(c)) for c in cols)
+
+
+def _insert_ignore(client, table, rows, conflict) -> List[Dict[str, Any]]:
+    if not rows:
+        return []
+    resp = client.table(table).upsert(rows, on_conflict=",".join(conflict),
+                                      ignore_duplicates=True).execute()
+    return list(getattr(resp, "data", None) or [])
+
+
+def run_job(snap: Dict[str, Any]) -> None:
+    started = time.monotonic()
+    counts = dict.fromkeys(("products", "variants", "offers", "offer_updates", "images",
+                            "reviews", "gaps", "gap_increments", "gap_cas_lost", "not_built"), 0)
+    client = _admin_client()
+    if client is None:
+        logger.warning("[KB_INGEST] no service-role client")
+        return
+    from app.services import live_robots
+    from app.services.price_service import OFFICIAL_BRAND_DOMAINS, _GENUINE_BH_SOURCE_METHODS
+
+    kb = kb_leaf()
+    records = live_robots.records_snapshot() or live_robots.load_records_sync(client) or {}
+    captured = snap.get("captured_at")
+    cap_iso = kb._ts_iso(captured)
+    conf = snap.get("identity_confidence")
+    rows = {t: [] for t in (KB_PRODUCTS_TABLE, KB_VARIANTS_TABLE, KB_OFFERS_TABLE,
+                            KB_IMAGES_TABLE, KB_REVIEWS_TABLE, KB_GAPS_TABLE)}
+
+    def _add(table, row):
+        if row is None:
+            counts["not_built"] += 1
+        else:
+            rows[table].append(row)
+
+    if conf in ("high", "medium"):
+        for prod in snap.get("products") or []:
+            pid = kb.kb_product_id(prod.get("brand") or "", prod.get("name") or "",
+                                   prod.get("variant"))
+            if pid is None:
+                continue
+            price = prod.get("price") or {}
+            url = price.get("url")
+            host = deny_hosts.normalize_host(jsonld_widen._url_host(url))
+            row = _record_for(records, host)
+            verdict_ok = (isinstance(url, str) and isinstance(row, dict)
+                          and live_robots.url_verdict(url, row, captured) is None)
+            cat = prod.get("category")
+            if conf == "high" and (cat is None or str(cat).strip().lower() == kb.KB_CATEGORY):
+                conc = pid.split("|")[3]
+                conc = None if conc == "-" else conc
+                _add(KB_PRODUCTS_TABLE, kb.build_product_row(
+                    id=pid, brand=prod.get("brand"), name=prod.get("name"),
+                    identity_confidence="high", updated_at=captured, concentration=conc))
+                size_ml = _size_ml(price)
+                vid = kb.kb_variant_key(pid, conc, size_ml)
+                facts = prod.get("jsonld_facts") or {}
+                gtin = facts.get("gtin") if kb.gtin_check_digit_ok(facts.get("gtin")) else None
+                sku = facts.get("sku") if isinstance(facts.get("sku"), str) else None
+                _add(KB_VARIANTS_TABLE, kb.build_variant_row(
+                    id=vid, product_id=pid, updated_at=captured, concentration=conc,
+                    size_ml=size_ml, gtin=gtin, sku=sku))
+                method = price.get("source_method")
+                rung = rung_for(method)
+                canon = kb.canonical_offer_url(url)
+                if (method in _GENUINE_BH_SOURCE_METHODS and rung is not None
+                        and price.get("estimated") is not True and canon is not None
+                        and verdict_ok and row.get("status") == "live"
+                        and snap.get("region") == "bahrain" and vid is not None):
+                    in_stock = price.get("in_stock") if isinstance(price.get("in_stock"), bool) else None
+                    _add(KB_OFFERS_TABLE, kb.build_offer_row(
+                        variant_id=vid, merchant_id=row.get("host"), market="BH",
+                        amount=price.get("amount"), observed_currency=price.get("currency"),
+                        evidence_rung=rung, canonical_url=canon, captured_at=captured,
+                        size_ml=size_ml, in_stock=in_stock))
+                img = price.get("image_url")
+                if (isinstance(img, str) and verdict_ok and jsonld_widen.allowed_image_url(
+                        img, url, OFFICIAL_BRAND_DOMAINS) is not None):
+                    _add(KB_IMAGES_TABLE, kb.build_image_row(
+                        product_id=pid, url=img, provenance_host=host,
+                        source="retailer_jsonld" if prod.get("jsonld_facts") else "retailer_og",
+                        captured_at=captured))
+                jr = prod.get("jsonld_rating")
+                if isinstance(jr, dict):
+                    count = jr.get("count") if isinstance(jr.get("count"), int) else None
+                    _add(KB_REVIEWS_TABLE, kb.build_review_row(
+                        product_id=pid, source="retailer_jsonld", source_url=jr.get("url"),
+                        aggregate_rating=jr.get("value"), review_count=count,
+                        captured_at=captured))
+            fs = prod.get("field_status") or {}
+            for field in D05_FIELDS:
+                if field == "identity" or (fs.get(field) or {}).get("state") != "unknown":
+                    continue
+                if len(rows[KB_GAPS_TABLE]) >= _gap_max():
+                    break
+                assert not field.startswith("pdp_")
+                state = "needs_operator" if isinstance(row, dict) and row.get(
+                    "status") == "blocked" else "open"
+                hint = row.get("host") if isinstance(row, dict) else None
+                _add(KB_GAPS_TABLE, kb.build_gap_row(
+                    product_key=pid, field=field, first_seen=captured, demand_count=1,
+                    state=state, source_hint=hint))
+
+    counts["products"] = len(_insert_ignore(client, KB_PRODUCTS_TABLE, rows[KB_PRODUCTS_TABLE], ("id",)))
+    counts["variants"] = len(_insert_ignore(client, KB_VARIANTS_TABLE, rows[KB_VARIANTS_TABLE], ("id",)))
+    obs = kb.KB_OFFER_OBSERVATION_KEY
+    got = _insert_ignore(client, KB_OFFERS_TABLE, rows[KB_OFFERS_TABLE], obs)
+    counts["offers"] = len(got)
+    got_keys = {_key(r, obs) for r in got}
+    for row in rows[KB_OFFERS_TABLE]:
+        if _key(row, obs) in got_keys:
+            continue
+        q = client.table(KB_OFFERS_TABLE).update({k: row[k] for k in kb.KB_OFFER_UPSERT_SET})
+        for col in obs:
+            q = q.eq(col, row[col])
+        q.execute()
+        counts["offer_updates"] += 1
+    counts["images"] = len(_insert_ignore(client, KB_IMAGES_TABLE, rows[KB_IMAGES_TABLE],
+                                          ("product_id", "url")))
+    counts["reviews"] = len(_insert_ignore(client, KB_REVIEWS_TABLE, rows[KB_REVIEWS_TABLE],
+                                           ("product_id", "source_url")))
+    gaps = rows[KB_GAPS_TABLE]
+    gkey = ("product_key", "field")
+    got = _insert_ignore(client, KB_GAPS_TABLE, gaps, gkey)
+    counts["gaps"] = len(got)
+    got_keys = {_key(r, gkey) for r in got}
+    missing = [g for g in gaps if _key(g, gkey) not in got_keys]
+    if missing:
+        resp = (client.table(KB_GAPS_TABLE).select("product_key,field,demand_count,state")
+                .in_("product_key", sorted({g["product_key"] for g in missing}))
+                .in_("field", sorted({g["field"] for g in missing})).execute())
+        existing = {_key(r, gkey): r for r in (getattr(resp, "data", None) or [])}
+        for g in missing:
+            cur = existing.get(_key(g, gkey))
+            if not cur or not isinstance(cur.get("demand_count"), int):
+                continue
+            n = cur["demand_count"]
+            out = (client.table(KB_GAPS_TABLE)
+                   .update({"demand_count": n + 1, "last_seen": cap_iso})
+                   .eq("product_key", g["product_key"]).eq("field", g["field"])
+                   .eq("demand_count", n).execute())
+            if getattr(out, "data", None):
+                counts["gap_increments"] += 1
+            else:
+                counts["gap_cas_lost"] += 1
+    logger.info(
+        "[KB_INGEST] job products=%d variants=%d offers=%d offer_updates=%d images=%d "
+        "reviews=%d gaps=%d gap_increments=%d gap_cas_lost=%d not_built=%d elapsed_ms=%d",
+        counts["products"], counts["variants"], counts["offers"], counts["offer_updates"],
+        counts["images"], counts["reviews"], counts["gaps"], counts["gap_increments"],
+        counts["gap_cas_lost"], counts["not_built"], int((time.monotonic() - started) * 1000))
