diff --git a/app/services/live_robots.py b/app/services/live_robots.py
new file mode 100644
index 00000000..85352f2d
--- /dev/null
+++ b/app/services/live_robots.py
@@ -0,0 +1,372 @@
+"""D14 LIVE-ROBOTS (PROTOTYPE, the RED round; thrown away): the verdict before
+every live fetch, read from the persisted S81-15 record through a per-process
+memo; the per-compare attempt aggregator and the ONE Redis health flush.
+
+Behind ENABLE_LIVE_ROBOTS_REGISTRY (+ ENABLE_LIVE_ROBOTS_HEALTH_FLUSH), read per
+call; flag OFF every hook is one env read."""
+import asyncio
+import contextvars
+import copy
+import logging
+import math
+import os
+import threading
+import time
+from datetime import datetime, timezone
+from typing import Any, Dict, Mapping, Optional
+from urllib.parse import urlsplit
+
+from app.services import deny_hosts, jsonld_widen
+
+logger = logging.getLogger(__name__)
+
+_TRUTHY = ("true", "1", "yes", "on")
+VERDICT_REASONS = ("bad_url", "denied", "no_row", "not_live", "no_record", "origin", "robots")
+OUTCOMES = ("ok", "fail", "robots_skip", "challenge")
+READ_COLUMNS = "host,status,deny,robots,challenge"
+READ_STATUSES = ("live", "blocked")
+VIEW_KEYS = ("host", "status", "deny", "robots", "challenge")
+PAGE_SIZE = 500
+
+
+def live_robots_enabled() -> bool:
+    return os.getenv("ENABLE_LIVE_ROBOTS_REGISTRY", "false").strip().lower() in _TRUTHY
+
+
+def health_flush_enabled() -> bool:
+    return os.getenv("ENABLE_LIVE_ROBOTS_HEALTH_FLUSH", "false").strip().lower() in _TRUTHY
+
+
+def _ttl_seconds() -> int:
+    raw = os.getenv("LIVE_ROBOTS_HEALTH_TTL_DAYS")
+    days = 8.0
+    if raw is not None:
+        try:
+            value = float(str(raw).strip())
+            if math.isfinite(value) and value > 0:
+                days = min(max(value, 1.0), 30.0)
+        except (TypeError, ValueError):
+            pass
+    return int(days) * 86400
+
+
+def _now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def _monotonic() -> float:
+    return time.monotonic()
+
+
+def _admin_client():
+    from app.services.database_service import get_admin_supabase_client
+    return get_admin_supabase_client()
+
+
+def _redis_client():
+    from app.services import cache_service
+    return cache_service.redis_client
+
+
+def _memo_seconds() -> float:
+    from app.services import merchant_registry
+    return merchant_registry.memo_seconds()
+
+
+def _read_timeout() -> float:
+    from app.services import merchant_registry
+    return merchant_registry.read_timeout_seconds()
+
+
+def _max_stale() -> float:
+    from app.services import merchant_registry
+    return merchant_registry.max_stale_seconds()
+
+
+def _origin_of(url: Any) -> str:
+    try:
+        parts = urlsplit(url)
+        host = (parts.hostname or "").lower()
+        port = parts.port
+    except (ValueError, TypeError, AttributeError):
+        return ""
+    if parts.scheme not in ("http", "https") or not host:
+        return ""
+    return parts.scheme + "://" + host + (":" + str(port) if port else "")
+
+
+def host_of(url: Any) -> str:
+    return deny_hosts.normalize_host(jsonld_widen._url_host(url))
+
+
+def outcome_of(resp: Any) -> str:
+    status = getattr(resp, "status_code", None)
+    if status == 200:
+        return "ok"
+    headers = getattr(resp, "headers", None) or {}
+    try:
+        mark = headers.get("cf-mitigated") or headers.get("Cf-Mitigated")
+    except Exception:  # noqa: BLE001
+        mark = None
+    if isinstance(mark, str) and mark.strip().lower() == "challenge":
+        return "challenge"
+    return "fail"
+
+
+def url_verdict(url: Any, row: Any, now: Any) -> Optional[str]:
+    try:
+        if not isinstance(url, str):
+            return "bad_url"
+        parts = urlsplit(url.strip())
+        if parts.scheme not in ("http", "https") or not parts.hostname:
+            return "bad_url"
+        if deny_hosts.is_denied_url(url):
+            return "denied"
+        if not isinstance(row, dict):
+            return "no_row"
+        if row.get("deny"):
+            return "denied"
+        if row.get("status") != "live":
+            return "not_live"
+        robots = row.get("robots")
+        if not isinstance(robots, dict) or not robots.get("origin"):
+            return "no_record"
+        if robots.get("origin") != _origin_of(url):
+            return "origin"
+        entry = {k: row.get(k) for k in ("status", "deny", "robots", "challenge")}
+        if not jsonld_widen.rating_host_allowed(entry, url, now):
+            return "robots"
+        return None
+    except Exception:  # noqa: BLE001 - fail-closed
+        return "bad_url"
+
+
+# --------------------------------------------------------------------- the memo
+_LOCK = threading.Lock()
+_STATE: Dict[str, Any] = {"rows": None, "loaded_at": None, "good_at": None, "failed": False,
+                          "warned_at": None}
+_REFRESH = None
+
+
+def _read_rows(client: Any) -> Dict[str, Dict[str, Any]]:
+    from app.services import merchant_registry
+
+    rows: Dict[str, Dict[str, Any]] = {}
+    start = 0
+    while True:
+        resp = (client.table(merchant_registry.KB_MERCHANTS_TABLE)
+                .select(READ_COLUMNS)
+                .in_("status", list(READ_STATUSES))
+                .order("host")
+                .range(start, start + PAGE_SIZE - 1)
+                .execute())
+        data = getattr(resp, "data", None) or []
+        for raw in data:
+            if not isinstance(raw, dict) or not isinstance(raw.get("host"), str):
+                continue
+            host = deny_hosts.normalize_host(raw["host"])
+            if not host:
+                continue
+            view = {k: copy.deepcopy(raw.get(k)) for k in VIEW_KEYS}
+            view["host"] = host
+            rows[host] = view
+        if len(data) < PAGE_SIZE:
+            break
+        start += PAGE_SIZE
+    return rows
+
+
+def load_records_sync(client: Any) -> Dict[str, Dict[str, Any]]:
+    rows = _read_rows(client)
+    now = _monotonic()
+    with _LOCK:
+        _STATE.update(rows=rows, loaded_at=now, good_at=now, failed=False)
+    return copy.deepcopy(rows)
+
+
+def records_snapshot() -> Optional[Dict[str, Dict[str, Any]]]:
+    try:
+        now = _monotonic()
+        with _LOCK:
+            rows, good_at = _STATE["rows"], _STATE["good_at"]
+        if rows is None or good_at is None or now - good_at > _memo_seconds():
+            return None
+        return copy.deepcopy(rows)
+    except Exception:  # noqa: BLE001
+        return None
+
+
+async def _refresh() -> None:
+    try:
+        client = _admin_client()
+        if client is None:
+            raise RuntimeError("no service-role client")
+        rows = await asyncio.wait_for(asyncio.to_thread(_read_rows, client), _read_timeout())
+        now = _monotonic()
+        with _LOCK:
+            _STATE.update(rows=rows, loaded_at=now, good_at=now, failed=False)
+    except Exception as exc:  # noqa: BLE001
+        now = _monotonic()
+        warn = False
+        with _LOCK:
+            _STATE["failed"] = True
+            _STATE["loaded_at"] = now
+            last = _STATE["warned_at"]
+            if last is None or now - last >= _memo_seconds():
+                _STATE["warned_at"] = now
+                warn = True
+        if warn:
+            logger.warning("[LIVE_ROBOTS] memo refresh failed: %s", type(exc).__name__)
+
+
+def _schedule_refresh() -> None:
+    global _REFRESH
+    try:
+        loop = asyncio.get_running_loop()
+    except RuntimeError:
+        return
+    with _LOCK:
+        current = _REFRESH
+        if current is not None and current[0] is loop and not current[1].done():
+            return
+    coro = _refresh()
+    try:
+        task = contextvars.Context().run(loop.create_task, coro)
+    except Exception:  # noqa: BLE001
+        coro.close()
+        return
+    with _LOCK:
+        _REFRESH = (loop, task)
+
+
+def _match(rows: Mapping[str, Any], host: str) -> Optional[Dict[str, Any]]:
+    if host in rows:
+        return rows[host]
+    best = None
+    for key in rows:
+        if host.endswith("." + key) and (best is None or len(key) > len(best)):
+            best = key
+    return rows[best] if best is not None else None
+
+
+def row_for_host(host: Any) -> Optional[Dict[str, Any]]:
+    try:
+        h = deny_hosts.normalize_host(host)
+        now = _monotonic()
+        with _LOCK:
+            rows, good_at, loaded_at = _STATE["rows"], _STATE["good_at"], _STATE["loaded_at"]
+        row = None
+        if h and rows is not None and good_at is not None and now - good_at <= _max_stale():
+            row = _match(rows, h)
+        if rows is None or loaded_at is None or now - loaded_at >= _memo_seconds():
+            _schedule_refresh()
+        return copy.deepcopy(row)
+    except Exception:  # noqa: BLE001
+        return None
+
+
+# ---------------------------------------------------------------- the hook
+def gate(url: Any, source: str) -> bool:
+    if not live_robots_enabled():
+        return True
+    host = ""
+    try:
+        host = host_of(url)
+        reason = url_verdict(url, row_for_host(host), _now())
+    except Exception:  # noqa: BLE001
+        reason = "bad_url"
+    if reason is None:
+        return True
+    record(source, host, "robots_skip")
+    logger.info("[LIVE_ROBOTS] skip source=%s host=%s reason=%s", source, host or "-", reason)
+    return False
+
+
+_ATTEMPTS_CTX: "contextvars.ContextVar[Optional[Dict[Any, int]]]" = contextvars.ContextVar(
+    "live_robots_attempts", default=None)
+
+
+def record(source: str, host: Any, outcome: str) -> None:
+    if not live_robots_enabled():
+        return
+    try:
+        if outcome not in OUTCOMES:
+            return
+        bucket = _ATTEMPTS_CTX.get()
+        if not isinstance(bucket, dict):
+            return
+        key = (str(source), deny_hosts.normalize_host(host), outcome)
+        bucket[key] = bucket.get(key, 0) + 1
+    except Exception:  # noqa: BLE001
+        return
+
+
+def bind_attempts() -> None:
+    if not live_robots_enabled():
+        return
+    _ATTEMPTS_CTX.set({})
+
+
+def _flush_sync(snapshot: Dict[Any, int], day: str, ttl: int) -> None:
+    client = _redis_client()
+    if client is None:
+        return
+    commands = []
+    keys = []
+    for (source, host, outcome), n in sorted(snapshot.items()):
+        if not host or not isinstance(n, int) or isinstance(n, bool) or n <= 0:
+            continue
+        key = "kbh:" + day + ":" + host
+        commands.append((key, source + ":" + outcome, n))
+        if key not in keys:
+            keys.append(key)
+    if not commands:
+        return
+    pipe = client.pipeline()
+    for key, field, n in commands:
+        pipe.hincrby(key, field, n)
+    for key in keys:
+        pipe.expire(key, ttl)
+    pipe.exec()
+
+
+async def _flush_job(snapshot: Dict[Any, int], day: str, ttl: int) -> None:
+    try:
+        from app.utils.redis_offloop import run_redis_offloop_pool
+        await run_redis_offloop_pool(_flush_sync, snapshot, day, ttl)
+    except Exception as exc:  # noqa: BLE001
+        logger.warning("[LIVE_ROBOTS] health flush failed: %s", type(exc).__name__)
+
+
+def flush_attempts() -> None:
+    if not live_robots_enabled():
+        return
+    try:
+        bucket = _ATTEMPTS_CTX.get()
+        if bucket is None:
+            return
+        _ATTEMPTS_CTX.set(None)
+        if not bucket or not health_flush_enabled():
+            return
+        try:
+            asyncio.get_running_loop()
+        except RuntimeError:
+            logger.debug("[LIVE_ROBOTS] flush dropped: no running loop")
+            return
+        from app.utils import async_utils
+        async_utils.fire_and_forget(_flush_job(dict(bucket), _now().strftime("%Y%m%d"),
+                                               _ttl_seconds()), "live_robots_health_flush")
+    except Exception:  # noqa: BLE001
+        return
+
+
+def robots_entry_lookup(host: str) -> Optional[Mapping[str, Any]]:
+    if not live_robots_enabled():
+        return None
+    row = row_for_host(host)
+    if not isinstance(row, dict):
+        return None
+    return {k: row.get(k) for k in ("status", "deny", "robots", "challenge")}
+
+
+jsonld_widen.ROBOTS_ENTRY_LOOKUP = robots_entry_lookup
