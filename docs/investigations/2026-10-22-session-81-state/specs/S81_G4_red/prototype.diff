diff --git a/app/services/kb_operator.py b/app/services/kb_operator.py
new file mode 100644
index 00000000..c9b8eeff
--- /dev/null
+++ b/app/services/kb_operator.py
@@ -0,0 +1,253 @@
+"""D16 OPERATOR-INGEST: the operator view and the captured-payload ingest.
+
+ENABLE_OPERATOR_INGEST (house boolean, read per call). OFF: ``operator_gate`` (the
+FIRST dependency of both admin routes) raises Starlette's base-class 404, rendered
+exactly like an unregistered path. ON: the existing ``verify_admin_key`` and the
+existing 30/min limiter apply; rows only through the S81-14 builders, insert-ignore.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import math
+import os
+import re
+from datetime import datetime, timezone
+from typing import Any, Dict, List, Literal, Optional
+from urllib.parse import urlsplit
+
+from pydantic import BaseModel, ConfigDict, Field, field_validator
+from starlette.exceptions import HTTPException as StarletteHTTPException
+
+logger = logging.getLogger(__name__)
+
+KB_SPECS_TABLE = "kb_specs"
+KB_COVERAGE_TABLE = "kb_coverage_daily"
+PAYLOAD_MAX_BYTES = 262_144
+_TRUTHY = ("true", "1", "yes", "on")
+_FIELD_RE = re.compile(r"^[a-z][a-z0-9_]{0,63}$")
+
+
+def operator_ingest_enabled() -> bool:
+    return os.getenv("ENABLE_OPERATOR_INGEST", "false").strip().lower() in _TRUTHY
+
+
+def page_max() -> int:
+    raw = os.getenv("KB_OPERATOR_PAGE_MAX")
+    try:
+        value = float(str(raw).strip()) if raw is not None else None
+    except (TypeError, ValueError):
+        value = None
+    if value is None or not math.isfinite(value) or value <= 0:
+        return 50
+    return int(min(max(value, 1), 200))
+
+
+def parse_limit(raw: Any) -> int:
+    cap = page_max()
+    try:
+        value = int(str(raw).strip())
+    except (TypeError, ValueError):
+        return cap
+    return min(max(value, 1), cap)
+
+
+def kb_leaf() -> Any:
+    from app.services import kb_service as _kb
+    return _kb
+
+
+def _now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def _admin_client() -> Any:
+    from app.services.database_service import get_admin_supabase_client
+    return get_admin_supabase_client()
+
+
+def operator_gate() -> None:
+    if not operator_ingest_enabled():
+        raise StarletteHTTPException(status_code=404)
+    return None
+
+
+class OperatorRefusal(Exception):
+    def __init__(self, code: str, message: str) -> None:
+        super().__init__(code)
+        self.code = code
+        self.message = message
+
+
+class OperatorPrice(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    amount: float = Field(gt=0, lt=1e11)
+    currency: str = Field(pattern=r"^[A-Z]{3}$")
+
+
+class OperatorIngest(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    source: Literal["operator", "partner"] = "operator"
+    page_url: str = Field(max_length=2048)
+    brand: Optional[str] = Field(default=None, min_length=1, max_length=128)
+    name: Optional[str] = Field(default=None, min_length=1, max_length=256)
+    variant: Optional[str] = Field(default=None, min_length=1, max_length=64)
+    jsonld: List[Dict[str, Any]] = Field(default_factory=list, max_length=20)
+    og_image: Optional[str] = Field(default=None, max_length=2048)
+    price: Optional[OperatorPrice] = None
+    market: str = Field(default="BH", pattern=r"^[A-Z]{2,3}$")
+    size_ml: Optional[int] = Field(default=None, ge=1, le=9999)
+    in_stock: Optional[bool] = None
+    captured_at: Optional[datetime] = None
+    specs: Dict[str, str] = Field(default_factory=dict, max_length=32)
+
+    @field_validator("specs")
+    @classmethod
+    def _specs_ok(cls, value: Dict[str, str]) -> Dict[str, str]:
+        for k, v in value.items():
+            if not _FIELD_RE.match(k) or not (1 <= len(v) <= 2000):
+                raise ValueError("bad spec entry")
+        return value
+
+
+def payload_too_large(body: OperatorIngest) -> bool:
+    return len(json.dumps(body.model_dump(mode="json"), ensure_ascii=True)) > PAYLOAD_MAX_BYTES
+
+
+def read_view(client: Any, limit: int) -> Dict[str, Any]:
+    from app.services import kb_ingest
+    from app.services import merchant_registry as _mr
+
+    resp = (client.table(_mr.KB_MERCHANTS_TABLE).select("host,status,blocked_reason,robots,tos")
+            .eq("status", "blocked").order("host").limit(limit).execute())
+    blocked = []
+    for r in getattr(resp, "data", None) or []:
+        robots = r.get("robots") if isinstance(r.get("robots"), dict) else {}
+        tos = r.get("tos") if isinstance(r.get("tos"), dict) else {}
+        blocked.append({"host": r.get("host"), "status": r.get("status"), "blocked_reason": r.get("blocked_reason"),
+                        "robots_state": robots.get("state"), "robots_fetched_at": robots.get("fetched_at"),
+                        "tos_verdict": tos.get("verdict"), "tos_reviewed_at": tos.get("reviewed_at")})
+    resp = (client.table(kb_ingest.KB_GAPS_TABLE).select("product_key,field,demand_count,last_seen,source_hint")
+            .eq("state", "needs_operator").order("demand_count", desc=True).order("last_seen", desc=True)
+            .limit(limit).execute())
+    needs = [{k: r.get(k) for k in ("product_key", "field", "demand_count", "last_seen", "source_hint")}
+             for r in getattr(resp, "data", None) or []]
+    resp = client.table(KB_COVERAGE_TABLE).select("day").order("day", desc=True).limit(1).execute()
+    days = getattr(resp, "data", None) or []
+    day = days[0].get("day") if days else None
+    metrics = []
+    if day is not None:
+        resp = client.table(KB_COVERAGE_TABLE).select("metric,value,n").eq("day", day).limit(200).execute()
+        metrics = [{k: r.get(k) for k in ("metric", "value", "n")} for r in getattr(resp, "data", None) or []]
+    return {"blocked": blocked, "needs_operator": needs, "coverage": {"day": day, "metrics": metrics},
+            "limit": limit}
+
+
+def _identity(body: OperatorIngest):
+    if body.brand and body.name:
+        return body.brand, body.name
+    for node in body.jsonld:
+        t = node.get("@type")
+        types = t if isinstance(t, list) else [t]
+        if "Product" in types:
+            brand = node.get("brand")
+            if isinstance(brand, dict):
+                brand = brand.get("name")
+            name = node.get("name")
+            if isinstance(brand, str) and isinstance(name, str):
+                return brand, name
+    return None, None
+
+
+def ingest(client: Any, body: OperatorIngest, now: datetime) -> Dict[str, int]:
+    from app.services import deny_hosts, kb_ingest, kb_serve
+    from app.services import merchant_registry as _mr
+
+    kb = kb_leaf()
+    if body.source == "operator" and set(body.specs) & set(kb_serve.LICENCE_FIELDS):
+        raise OperatorRefusal("KB_LICENCE_FIELD", "Licence fields need a partner source.")
+    canonical = kb.canonical_offer_url(body.page_url)
+    if canonical is None or not kb.kb_source_allowed(canonical) or deny_hosts.is_denied_url(body.page_url):
+        raise OperatorRefusal("KB_URL_REFUSED", "The page URL is refused.")
+    host = (urlsplit(canonical).hostname or "").lower()
+    labels = host.split(".")
+    cands = [".".join(labels[i:]) for i in range(len(labels) - 1)]
+    resp = client.table(_mr.KB_MERCHANTS_TABLE).select("host,status,deny,tos").in_("host", cands).execute()
+    rows = [r for r in getattr(resp, "data", None) or [] if isinstance(r, dict)]
+    rows.sort(key=lambda r: len(str(r.get("host") or "")), reverse=True)
+    row = rows[0] if rows else None
+    if row is None:
+        raise OperatorRefusal("KB_HOST_UNKNOWN", "The host is not in the registry.")
+    if row.get("deny"):
+        raise OperatorRefusal("KB_URL_REFUSED", "The page URL is refused.")
+    status = row.get("status")
+    tos = row.get("tos") if isinstance(row.get("tos"), dict) else {}
+    if status == "candidate":
+        raise OperatorRefusal("KB_HOST_CANDIDATE", "The host is a candidate.")
+    if status == "blocked" and not (isinstance(tos.get("reviewed_at"), str) and tos.get("reviewed_at").strip()):
+        raise OperatorRefusal("KB_HOST_NOT_REVIEWED", "The host terms are not reviewed.")
+    if status not in ("live", "blocked"):
+        raise OperatorRefusal("KB_HOST_CANDIDATE", "The host is not live.")
+    brand, name = _identity(body)
+    pid = kb.kb_product_id(brand, name, body.variant)
+    if pid is None:
+        raise OperatorRefusal("KB_IDENTITY_UNRESOLVED", "The product identity is unresolved.")
+    counts = {"products": 0, "variants": 0, "offers": 0, "images": 0, "specs": 0, "gaps_closed": 0, "not_built": 0}
+    merchant = str(row.get("host"))
+    conc = pid.split("|")[3]
+    conc = conc if conc in kb.kb_concentrations() else None
+    vid = kb.kb_variant_key(pid, conc, body.size_ml)
+    captured = body.captured_at or now
+    filled = set()
+
+    def built(row_):
+        if row_ is None:
+            counts["not_built"] += 1
+            return []
+        return [row_]
+
+    products = built(kb.build_product_row(id=pid, brand=brand, name=name, identity_confidence="high",
+                                          updated_at=now, concentration=conc))
+    variants = built(kb.build_variant_row(id=vid, product_id=pid, updated_at=now, concentration=conc,
+                                          size_ml=body.size_ml))
+    offers = []
+    if body.price is not None:
+        offers = built(kb.build_offer_row(
+            variant_id=vid, merchant_id=merchant, market=body.market, amount=body.price.amount,
+            observed_currency=body.price.currency, evidence_rung="operator", canonical_url=canonical,
+            captured_at=captured, size_ml=body.size_ml, in_stock=body.in_stock))
+    images = []
+    if isinstance(body.og_image, str) and body.og_image.startswith("https://"):
+        images = built(kb.build_image_row(product_id=pid, url=body.og_image, provenance_host=merchant,
+                                          source="operator", captured_at=now))
+    specs = []
+    for field, value in body.specs.items():
+        specs += built(kb.build_spec_row(product_id=pid, field=field, value=value, extractor="operator",
+                                         captured_at=now, lang="en", source_url=canonical, cited=True))
+    counts["products"] = len(kb_ingest._insert_ignore(client, kb_ingest.KB_PRODUCTS_TABLE, products, ("id",)))
+    counts["variants"] = len(kb_ingest._insert_ignore(client, kb_ingest.KB_VARIANTS_TABLE, variants, ("id",)))
+    returned = kb_ingest._insert_ignore(client, kb_ingest.KB_OFFERS_TABLE, offers, tuple(kb.KB_OFFER_OBSERVATION_KEY))
+    counts["offers"] = len(returned)
+    upd: Dict[str, int] = {"offer_updates": 0}
+    kb_ingest._offer_rows_changed(client, kb, offers, returned, upd)
+    counts["images"] = len(kb_ingest._insert_ignore(client, kb_ingest.KB_IMAGES_TABLE, images, ("product_id", "url")))
+    counts["specs"] = len(kb_ingest._insert_ignore(client, KB_SPECS_TABLE, specs, ("product_id", "field", "lang")))
+    if offers:
+        filled.add("price")
+    if images:
+        filled.add("image")
+    if body.size_ml and variants:
+        filled.add("size")
+    if conc:
+        filled.add("concentration")
+    if specs:
+        filled.add("specs")
+    if filled:
+        resp = (client.table(kb_ingest.KB_GAPS_TABLE).update({"state": "closed"}).eq("product_key", pid)
+                .in_("field", sorted(filled)).in_("state", ["open", "needs_operator"]).execute())
+        counts["gaps_closed"] = len(getattr(resp, "data", None) or [])
+    logger.info(
+        "[KB_OPERATOR] ingest source=%s host=%s products=%d variants=%d offers=%d images=%d specs=%d "
+        "gaps_closed=%d not_built=%d", body.source, merchant, counts["products"], counts["variants"],
+        counts["offers"], counts["images"], counts["specs"], counts["gaps_closed"], counts["not_built"])
+    return counts
diff --git a/app/services/kb_serve.py b/app/services/kb_serve.py
new file mode 100644
index 00000000..4172e063
--- /dev/null
+++ b/app/services/kb_serve.py
@@ -0,0 +1,299 @@
+"""S81-18 KB-FIRST-SERVE + the verdict-cache key log.
+
+ENABLE_KB_FIRST_SERVE (house boolean, read per call): one gathered kb_product_card
+read per compare, the KB-served legs, the X-Client-Capabilities read and
+metadata.kb_hit. ENABLE_VERDICT_CACHE_LOG (independent): the would-hit key line.
+Stdlib only at module top; the leaf through kb_leaf(), everything else lazily.
+"""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import logging
+import math
+import os
+import threading
+from collections import OrderedDict
+from datetime import datetime, timezone
+from typing import Any, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+KB_PRODUCT_CARD_RPC = "kb_product_card"
+LICENCE_FIELDS = ("notes_top", "notes_heart", "notes_base", "longevity", "sillage")
+KB_HIT_VALUES = ("full", "partial", "miss")
+_TRUTHY = ("true", "1", "yes", "on")
+_SEEN: "OrderedDict[str, bool]" = OrderedDict()
+_SEEN_LOCK = threading.Lock()
+
+
+def kb_first_serve_enabled() -> bool:
+    return os.getenv("ENABLE_KB_FIRST_SERVE", "false").strip().lower() in _TRUTHY
+
+
+def verdict_cache_log_enabled() -> bool:
+    return os.getenv("ENABLE_VERDICT_CACHE_LOG", "false").strip().lower() in _TRUTHY
+
+
+def _knob(name: str, default: float, low: float, high: float) -> float:
+    raw = os.getenv(name)
+    try:
+        value = float(str(raw).strip()) if raw is not None else None
+    except (TypeError, ValueError):
+        value = None
+    if value is None or not math.isfinite(value) or value <= 0:
+        return default
+    return min(max(value, low), high)
+
+
+def timeout_seconds() -> float:
+    return float(_knob("KB_FIRST_SERVE_TIMEOUT_SECONDS", 1.0, 0.2, 3.0))
+
+
+def max_asof_days() -> int:
+    return int(_knob("KB_FIRST_SERVE_MAX_ASOF_DAYS", 30, 8, 90))
+
+
+def max_log_keys() -> int:
+    return int(_knob("VERDICT_CACHE_LOG_MAX_KEYS", 10000, 100, 100000))
+
+
+def _now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def _admin_client() -> Any:
+    from app.services.database_service import get_admin_supabase_client
+    return get_admin_supabase_client()
+
+
+def kb_leaf() -> Any:
+    from app.services import kb_service as _kb
+    return _kb
+
+
+def client_price_asof(request: Any) -> bool:
+    if not kb_first_serve_enabled():
+        return False
+    try:
+        value = request.headers.get("x-client-capabilities")
+        if not isinstance(value, str) or len(value) > 512:
+            return False
+        return "price_asof" in {t.strip().lower() for t in value.split(",")}
+    except Exception:  # noqa: BLE001
+        return False
+
+
+def required_spec_fields(category: Any) -> tuple:
+    from app.services.extraction_service import CRITICAL_SCHEMA_FIELDS
+    return tuple(f for f in CRITICAL_SCHEMA_FIELDS.get(category, []) if f not in LICENCE_FIELDS)
+
+
+async def fetch_cards(products: List[Dict[str, Any]], lang: Optional[str]) -> List[Optional[Dict[str, Any]]]:
+    try:
+        from app.utils import db_offload
+        kb = kb_leaf()
+        client = _admin_client()
+        if client is None:
+            raise RuntimeError("no client")
+        p_lang = "ar" if lang == "ar" else "en"
+
+        async def one(product):
+            product = product if isinstance(product, dict) else {}
+            pid = kb.kb_product_id(product.get("brand"), product.get("name"), product.get("variant"))
+            if pid is None:
+                return None
+            resp = await db_offload.run_db(
+                lambda: client.rpc(KB_PRODUCT_CARD_RPC, {"p_product_id": pid, "p_lang": p_lang}).execute())
+            data = getattr(resp, "data", None)
+            if isinstance(data, dict) and isinstance(data.get("product"), dict):
+                return data
+            return None
+
+        out = await asyncio.wait_for(asyncio.gather(*(one(p) for p in list(products)[:2])),
+                                     timeout=timeout_seconds())
+        return list(out) + [None] * (2 - len(out))
+    except Exception as exc:  # noqa: BLE001 - total, never raises
+        logger.warning("[KB_SERVE] card read failed: %s", type(exc).__name__)
+        return [None, None]
+
+
+def _parse_ts(value: Any) -> Optional[datetime]:
+    if not isinstance(value, str):
+        return None
+    try:
+        out = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    return out if out.tzinfo else out.replace(tzinfo=timezone.utc)
+
+
+def _miss() -> Dict[str, Any]:
+    return {"hit": "miss", "pid": None, "version": None, "price": None, "price_state": "none", "candidates": [],
+            "specs": None, "specs_complete": False, "image_url": None, "reviews": None, "rating": None,
+            "review_count": None}
+
+
+def classify(card: Any, *, category: Any, region: Any, now: datetime, accepts_asof: bool) -> Dict[str, Any]:
+    if not isinstance(card, dict) or not isinstance(card.get("product"), dict):
+        return _miss()
+    from app.services import image_service, product_data_service
+    kb = kb_leaf()
+    product = card["product"]
+    out = _miss()
+    out["pid"] = product.get("id")
+    version = product.get("updated_at")
+    if not (isinstance(version, str) and version):
+        version = hashlib.sha256(json.dumps(card, sort_keys=True, separators=(",", ":"), default=str)
+                                 .encode("utf-8")).hexdigest()[:16]
+    out["version"] = version
+    sizes = {}
+    for v in card.get("variants") or []:
+        if isinstance(v, dict):
+            sizes[v.get("id")] = v.get("size_ml")
+    ttl = product_data_service.GENUINE_PRICE_DB_TTL
+    eligible = []
+    for o in card.get("offers") or []:
+        if not isinstance(o, dict):
+            continue
+        amount = o.get("amount")
+        try:
+            amount = float(amount)
+        except (TypeError, ValueError):
+            continue
+        if not (region == "bahrain" and o.get("market") == "BH" and o.get("observed_currency") == "BHD"
+                and amount > 0 and o.get("in_stock") is not False and kb.kb_source_allowed(o.get("canonical_url"))):
+            continue
+        seen = _parse_ts(o.get("last_seen"))
+        if seen is None:
+            continue
+        age = now - seen
+        if age <= ttl:
+            cls = "fresh"
+        elif accepts_asof and age.total_seconds() <= max_asof_days() * 86400:
+            cls = "asof"
+        else:
+            cls = "stale"
+        eligible.append((cls, seen, amount, str(o.get("variant_id")), o))
+
+    def price_dict(item):
+        _cls, seen, amount, vid, o = item
+        size = sizes.get(o.get("variant_id"))
+        parts = [product.get("brand"), product.get("name"), product.get("concentration")]
+        title = " ".join(str(p) for p in parts if p) + (" %dml" % size if isinstance(size, int) else "")
+        d = {"amount": amount, "currency": "BHD", "retailer": o.get("merchant_id"), "url": o.get("canonical_url"),
+             "source_method": "page_scrape", "estimated": False, "title": title.strip(),
+             "as_of": seen.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+             "_cached": True, "_cache_source": "kb"}
+        if isinstance(size, int):
+            d["size"] = "%dml" % size
+        if isinstance(o.get("in_stock"), bool):
+            d["in_stock"] = o["in_stock"]
+        return d
+
+    for cls in ("fresh", "asof"):
+        group = [e for e in eligible if e[0] == cls]
+        if group:
+            group.sort(key=lambda e: (-e[1].timestamp(), e[2], e[3]))
+            out["price"] = price_dict(group[0])
+            out["price_state"] = cls
+            out["candidates"] = [price_dict(e) for e in group]
+            break
+    else:
+        out["price_state"] = "stale_refused" if eligible else "none"
+    specs = {}
+    for s in card.get("specs") or []:
+        if isinstance(s, dict) and isinstance(s.get("field"), str) and s.get("value") not in (None, ""):
+            specs.setdefault(s["field"], s["value"])
+    if specs:
+        out["specs"] = dict(specs, _field_confidence={f: "kb_cited" for f in specs}, _cached=True,
+                            _cache_source="kb")
+    req = set(required_spec_fields(category))
+    out["specs_complete"] = bool(specs) and req <= set(specs)
+    for img in card.get("images") or []:
+        url = img.get("url") if isinstance(img, dict) else None
+        if (isinstance(url, str) and url.startswith("https://") and image_service._is_valid_image_url(url)
+                and kb.kb_source_allowed(url)):
+            out["image_url"] = url
+            break
+    rating = card.get("rating") if isinstance(card.get("rating"), dict) else {}
+    value = rating.get("rating")
+    if (rating.get("sources") or 0) > 0 and isinstance(value, (int, float)) and not isinstance(value, bool):
+        count = rating.get("review_count")
+        count = count if isinstance(count, int) and not isinstance(count, bool) else None
+        out["reviews"] = {"average_rating": float(value), "total_reviews": count, "_cached": True,
+                          "_cache_source": "kb"}
+        out["rating"], out["review_count"] = float(value), count
+    full = (product.get("identity_confidence") == "high" and out["price_state"] in ("fresh", "asof")
+            and out["specs_complete"] and out["image_url"] is not None)
+    out["hit"] = "full" if full else "partial"
+    return out
+
+
+async def served(value: Any) -> Any:
+    return value
+
+
+def verdict_key(*, pids, versions, scores_summary, winner_index, lang, model, prompt) -> str:
+    def h(text):
+        return hashlib.sha256((text or "").encode("utf-8")).hexdigest()
+    parts = [pids[0] or "-", pids[1] or "-", versions[0] or "-", versions[1] or "-", h(scores_summary),
+             str(int(winner_index)), lang or "en", model or "-", h(prompt)]
+    return hashlib.sha256("\x1f".join(parts).encode("utf-8")).hexdigest()
+
+
+def _prompt_digest_input(category: Any, comparison_quality: Any, product_data: Any) -> str:
+    """R-G4-3: the verdict prompt over two pid-only stubs (no specs / price / reviews)."""
+    from app.services import extraction_service
+    stubs = []
+    for p in list(product_data or [])[:2]:
+        p = p if isinstance(p, dict) else {}
+        stubs.append({"brand": p.get("brand"), "name": p.get("name"), "variant": p.get("variant"),
+                      "specs": {}, "price": None, "reviews": None})
+    while len(stubs) < 2:
+        stubs.append({"brand": None, "name": None, "variant": None, "specs": {}, "price": None, "reviews": None})
+    return extraction_service.build_verdict_prompt(products=stubs, comparison_quality=comparison_quality,
+                                                   user_cohort=None, category=category)
+
+
+def log_verdict_key(*, user_preferences, demographics_profile, behavior_profile, product_data, scores_summary,
+                    winner_index, lang, category, comparison_quality, views) -> Optional[str]:
+    if not verdict_cache_log_enabled():
+        return None
+    try:
+        if user_preferences or demographics_profile is not None or behavior_profile is not None:
+            return None
+        from app.services import model_config
+        kb = kb_leaf()
+        pids, versions = [], []
+        for i in range(2):
+            view = views[i] if isinstance(views, (list, tuple)) and len(views) > i and isinstance(views[i], dict) else None
+            if view and view.get("hit") != "miss" and view.get("pid"):
+                pids.append(view.get("pid"))
+                versions.append(view.get("version") or "-")
+            else:
+                p = product_data[i] if product_data and len(product_data) > i and isinstance(product_data[i], dict) else {}
+                pids.append(kb.kb_product_id(p.get("brand"), p.get("name"), p.get("variant")) or "-")
+                versions.append("-")
+        prompt = _prompt_digest_input(category, comparison_quality, product_data)
+        key = verdict_key(pids=pids, versions=versions, scores_summary=scores_summary, winner_index=winner_index,
+                          lang=lang, model=model_config.verdict_model(), prompt=prompt)
+        with _SEEN_LOCK:
+            would_hit = key in _SEEN
+        logger.info("[VERDICT_CACHE] would_hit=%d key=%s", int(would_hit), key[:16])
+        return key
+    except Exception as exc:  # noqa: BLE001
+        logger.debug("[VERDICT_CACHE] key failed: %s", type(exc).__name__)
+        return None
+
+
+def seed_verdict_key(key: Optional[str]) -> None:
+    if key is None:
+        return
+    with _SEEN_LOCK:
+        _SEEN[key] = True
+        _SEEN.move_to_end(key)
+        cap = max_log_keys()
+        while len(_SEEN) > cap:
+            _SEEN.popitem(last=False)
