diff --git a/scripts/cron_kb_coverage.py b/scripts/cron_kb_coverage.py
new file mode 100644
index 00000000..ac6b57f3
--- /dev/null
+++ b/scripts/cron_kb_coverage.py
@@ -0,0 +1,312 @@
+"""D17 MEASURE-COVERAGE: the daily kb_coverage_daily rollup (off-clock).
+
+ENABLE_KB_COVERAGE_ROLLUP (the G2 mode idiom: unset / garbage OFF, the house truthy
+set DRY, ``apply`` WRITE; ``--dry-run`` downgrades apply). OFF = one env read and one
+INFO line; nothing imported or read. DRY prints every metric line and writes the
+--report markdown, never the DB; APPLY additionally upserts every row ONCE per
+(day, metric) through the S81-14 coverage-row builder.
+"""
+from __future__ import annotations
+
+import argparse
+import logging
+import statistics
+from datetime import datetime, timedelta, timezone
+from typing import Any, Dict, List, Optional
+
+import scripts.kb_seed_common as common
+
+logger = logging.getLogger("cron_kb_coverage")
+PREFIX = "[KB_COVERAGE]"
+KB_COVERAGE_TABLE = "kb_coverage_daily"
+KB_OFFERS_LATEST_VIEW = "kb_offers_latest"
+SEARCH_LOG_COLUMNS = "products_found,success,is_synthetic,created_at"
+REQUIRED_SPEC_FIELDS = ("concentration", "scent_family", "season")
+GAP_STATES = ("open", "queued", "needs_operator", "licence", "closed")
+HINT_STATES = ("queued", "closed", "needs_operator")
+FRESH_DAYS = 7
+
+
+def coverage_mode() -> str:
+    return common.run_mode("ENABLE_KB_COVERAGE_ROLLUP")
+
+
+def max_hosts() -> int:
+    return common.int_knob("KB_COVERAGE_MAX_HOSTS", 500, 1, 5000)
+
+
+def _parse_ts(value: Any) -> Optional[datetime]:
+    if not isinstance(value, str):
+        return None
+    try:
+        out = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    return out if out.tzinfo else out.replace(tzinfo=timezone.utc)
+
+
+def _paged(client: Any, table: str, columns: str, filters=()) -> List[Dict[str, Any]]:
+    rows: List[Dict[str, Any]] = []
+    for page in range(common.MAX_PAGES):
+        start = page * common.PAGE_SIZE
+        q = client.table(table).select(columns)
+        for name, args in filters:
+            q = getattr(q, name)(*args)
+        resp = q.range(start, start + common.PAGE_SIZE - 1).execute()
+        data = getattr(resp, "data", None)
+        if not isinstance(data, list):
+            raise TypeError("page is not a list")
+        rows.extend(r for r in data if isinstance(r, dict))
+        if len(data) < common.PAGE_SIZE:
+            break
+    return rows
+
+
+def _norm(text: Any) -> str:
+    if not isinstance(text, str):
+        return ""
+    chars = [c if c.isalnum() else " " for c in text.casefold()]
+    return " ".join("".join(chars).split())
+
+
+def _share(num: int, den: int) -> float:
+    return round(num / den, 4) if den else 0.0
+
+
+def _metrics(client: Any, redis: Any, day, now) -> (List, Dict[str, int]):
+    out: List = []
+    info = {"redis": 0}
+
+    def add(name, value, n):
+        out.append((name, value, n))
+
+    def family(fn):
+        try:
+            fn()
+        except Exception as exc:  # noqa: BLE001 - one family omitted
+            logger.warning("%s metric family failed (%s)", PREFIX, type(exc).__name__)
+
+    products: List[Dict[str, Any]] = []
+
+    def _products():
+        products.extend(_paged(client, common.KB_PRODUCTS_TABLE, "id,brand,name,identity_confidence,concentration"))
+    family(_products)
+    ids = [p.get("id") for p in products]
+    total = len(ids)
+    if products:
+        add("kb.products.total", total, total)
+        add("kb.products.identity_high_share",
+            _share(sum(1 for p in products if p.get("identity_confidence") == "high"), total), total)
+
+    def pid_of(variant_id):
+        return variant_id.rsplit("|", 1)[0] if isinstance(variant_id, str) and "|" in variant_id else None
+
+    offers: List[Dict[str, Any]] = []
+    sizes = set()
+    images = set()
+    reviews = set()
+    cited = set()
+    state = {"offers": False, "images": False, "specs": False, "reviews": False, "variants": False}
+
+    def _offers():
+        offers.extend(_paged(client, KB_OFFERS_LATEST_VIEW, "variant_id,last_seen,captured_at"))
+        state["offers"] = True
+    family(_offers)
+
+    def _variants():
+        for v in _paged(client, common.KB_VARIANTS_TABLE, "product_id,size_ml"):
+            if v.get("size_ml") is not None:
+                sizes.add(v.get("product_id"))
+        state["variants"] = True
+    family(_variants)
+
+    def _images():
+        from app.services import kb_ingest
+        for r in _paged(client, kb_ingest.KB_IMAGES_TABLE, "product_id"):
+            images.add(r.get("product_id"))
+        state["images"] = True
+    family(_images)
+
+    def _specs():
+        have: Dict[str, set] = {}
+        for r in _paged(client, common.KB_SPECS_TABLE, "product_id,field,cited"):
+            if r.get("cited") is True:
+                have.setdefault(r.get("product_id"), set()).add(r.get("field"))
+        for pid, fields in have.items():
+            if set(REQUIRED_SPEC_FIELDS) <= fields:
+                cited.add(pid)
+        state["specs"] = True
+    family(_specs)
+
+    def _reviews():
+        from app.services import kb_ingest
+        for r in _paged(client, kb_ingest.KB_REVIEWS_TABLE, "product_id"):
+            reviews.add(r.get("product_id"))
+        state["reviews"] = True
+    family(_reviews)
+
+    fresh_cut = now - timedelta(days=FRESH_DAYS)
+    with_offer = {pid_of(o.get("variant_id")) for o in offers}
+    fresh = {pid_of(o.get("variant_id")) for o in offers
+             if (_parse_ts(o.get("last_seen")) or fresh_cut - timedelta(1)) >= fresh_cut}
+    conc = {p.get("id") for p in products if p.get("concentration")}
+    if products:
+        if state["offers"]:
+            add("kb.field.offer_share", _share(len([i for i in ids if i in with_offer]), total), total)
+            add("kb.field.offer_fresh_share", _share(len([i for i in ids if i in fresh]), total), total)
+        if state["images"]:
+            add("kb.field.image_share", _share(len([i for i in ids if i in images]), total), total)
+        if state["specs"]:
+            add("kb.field.specs_cited_share", _share(len([i for i in ids if i in cited]), total), total)
+        if state["reviews"]:
+            add("kb.field.rating_share", _share(len([i for i in ids if i in reviews]), total), total)
+        if state["variants"]:
+            add("kb.field.size_share", _share(len([i for i in ids if i in sizes]), total), total)
+        add("kb.field.concentration_share", _share(len([i for i in ids if i in conc]), total), total)
+        if all(state.values()):
+            complete = [i for i in ids if i in fresh and i in images and i in cited and i in sizes and i in conc]
+            add("kb.field.complete_share", _share(len(complete), total), total)
+    if state["offers"] and offers:
+        ages = [(now - t).total_seconds() / 3600.0 for t in (_parse_ts(o.get("last_seen")) for o in offers) if t]
+        caps = [(now - t).total_seconds() / 3600.0 for t in (_parse_ts(o.get("captured_at")) for o in offers) if t]
+        if ages:
+            add("kb.price.age_median_hours", round(statistics.median(ages), 2), len(ages))
+        if caps:
+            add("kb.price.capture_age_median_hours", round(statistics.median(caps), 2), len(caps))
+
+    def _gaps():
+        rows = _paged(client, common.KB_GAPS_TABLE, "field,state")
+        gaps = [r for r in rows if not str(r.get("field") or "").startswith("pdp_")]
+        hints = [r for r in rows if str(r.get("field") or "").startswith("pdp_")]
+        for s in GAP_STATES:
+            c = sum(1 for r in gaps if r.get("state") == s)
+            add("kb.gaps.state." + s, c, c)
+        for s in HINT_STATES:
+            c = sum(1 for r in hints if r.get("state") == s)
+            add("kb.hints.state." + s, c, c)
+    family(_gaps)
+
+    def _proxy():
+        start = datetime(day.year, day.month, day.day, tzinfo=timezone.utc)
+        end = start + timedelta(days=1)
+        rows = _paged(client, "search_logs", SEARCH_LOG_COLUMNS,
+                      (("gte", ("created_at", start.isoformat())), ("lt", ("created_at", end.isoformat()))))
+        known = set()
+        for p in products:
+            known.add(_norm(p.get("name")))
+            known.add(_norm(str(p.get("brand") or "") + " " + str(p.get("name") or "")))
+        known.discard("")
+        names = hits = pairs = pair_hits = 0
+        for r in rows:
+            if r.get("success") is not True or r.get("is_synthetic") is True:
+                continue
+            found = r.get("products_found")
+            found = found if isinstance(found, list) else []
+            got = []
+            for item in found:
+                name = item.get("name") if isinstance(item, dict) else item
+                got.append(_norm(name) in known)
+            names += len(got)
+            hits += sum(got)
+            if len(got) == 2:
+                pairs += 1
+                pair_hits += 1 if all(got) else 0
+        add("proxy.identity_hit_share", _share(hits, names), names)
+        add("proxy.pair_hit_share", _share(pair_hits, pairs), pairs)
+    family(_proxy)
+
+    def _hosts():
+        if redis is None:
+            return
+        rows = [r for r in common.read_merchant_rows(client) if r.get("status") in ("live", "blocked")]
+        hosts = sorted(str(r.get("host")) for r in rows if r.get("host"))[:max_hosts()]
+        keys = ["kbh:" + day.strftime("%Y%m%d") + ":" + h for h in hosts]
+        pipe = redis.pipeline()
+        for k in keys:
+            pipe.hgetall(k)
+        res = pipe.exec() if hasattr(pipe, "exec") else pipe.execute()
+        info["redis"] = 1
+        for host, fields in zip(hosts, res or []):
+            if not isinstance(fields, dict) or not fields:
+                continue
+            total_n = skip = chal = 0
+            for k, v in fields.items():
+                try:
+                    n = int(v)
+                except (TypeError, ValueError):
+                    continue
+                total_n += n
+                k = k.decode() if isinstance(k, bytes) else str(k)
+                if k.endswith(":robots_skip"):
+                    skip += n
+                elif k.endswith(":challenge"):
+                    chal += n
+            add("host.robots_skip:" + host, skip, total_n)
+            add("host.challenge:" + host, chal, total_n)
+    family(_hosts)
+    return out, info
+
+
+def _report(path: Optional[str], day, metrics) -> None:
+    if not path:
+        return
+    lines = ["# KB coverage " + day.isoformat(), "", "| metric | value | n |", "|---|---|---|"]
+    for name, value, n in metrics:
+        lines.append("| %s | %s | %d |" % (name, value, n))
+    lines += ["", "Proxy metrics are computed from search_logs product names, not compare_runs (S81-22)."]
+    with open(path, "w", encoding="ascii", newline="\n") as fh:
+        fh.write("\n".join(lines) + "\n")
+
+
+def main(argv: Optional[List[str]] = None, client: Any = None, redis: Any = None) -> int:
+    mode = coverage_mode()
+    if mode == common.MODE_OFF:
+        logger.info("%s mode=off ENABLE_KB_COVERAGE_ROLLUP not set; skipping run", PREFIX)
+        return 0
+    p = argparse.ArgumentParser(prog="cron_kb_coverage")
+    p.add_argument("--dry-run", action="store_true")
+    p.add_argument("--report", default=None)
+    p.add_argument("--day", default=None)
+    args = p.parse_args(argv)
+    mode = common.cli_mode(mode, args.dry_run)
+    now = common._now()
+    day = (datetime.strptime(args.day, "%Y-%m-%d").date() if args.day
+           else (now - timedelta(days=1)).date())
+    logger.info("%s mode=%s day=%s", PREFIX, mode, day.isoformat())
+    client = common.resolve_client(client, PREFIX)
+    if client is None:
+        return 0
+    if redis is None:
+        try:
+            from app.services import cache_service
+            redis = cache_service.redis_client
+        except Exception:  # noqa: BLE001
+            redis = None
+    metrics, info = _metrics(client, redis, day, now)
+    kb = common.kb_leaf()
+    rows, not_built, skipped = [], 0, 0
+    for name, value, n in metrics:
+        if len(name) > 128:
+            skipped += 1
+            continue
+        logger.info("%s metric=%s value=%s n=%d", PREFIX, name, value, n)
+        row = kb.build_coverage_row(day=day, metric=name, value=value, n=n)
+        if row is None:
+            not_built += 1
+            continue
+        rows.append(row)
+    _report(args.report, day, metrics)
+    if mode == common.MODE_APPLY and rows:
+        try:
+            client.table(KB_COVERAGE_TABLE).upsert(rows, on_conflict="day,metric").execute()
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("%s upsert failed (%s)", PREFIX, type(exc).__name__)
+    logger.info("%s totals rows=%d not_built=%d skipped_long=%d redis=%d", PREFIX, len(rows), not_built, skipped,
+                info["redis"])
+    return 0
+
+
+run = main
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
diff --git a/scripts/cron_kb_enrich.py b/scripts/cron_kb_enrich.py
new file mode 100644
index 00000000..24d613bd
--- /dev/null
+++ b/scripts/cron_kb_enrich.py
@@ -0,0 +1,451 @@
+"""S81-19 GAP-QUEUE: the off-clock KB enrich worker + the price refresh.
+
+ENABLE_KB_ENRICH_WORKER (the G2 mode idiom), ENABLE_KB_GAP_FILL (the gap-ladder leg),
+ENABLE_KB_GAP_WEB_SEARCH (INERT: logs not_built once per run). OFF = one env read and
+one INFO line; nothing imported. DRY reads only. APPLY walks the ladder per product
+under a Redis single flight (fail-closed) and refreshes the stored offers.
+"""
+from __future__ import annotations
+
+import argparse
+import asyncio
+import hashlib
+import json
+import logging
+import re
+import uuid
+from collections import Counter
+from datetime import timedelta
+from typing import Any, Dict, List, Optional, Tuple
+from urllib.parse import quote_plus, urljoin, urlsplit
+
+import scripts.kb_seed_common as common
+
+logger = logging.getLogger("cron_kb_enrich")
+PREFIX = "[KB_ENRICH]"
+LICENCE_GAP_FIELDS = ("specs",)
+FETCH_FIELDS = ("price", "image", "size", "concentration", "rating", "review_count")
+LOCK_PREFIX = "kbenrich:sf:"
+TOTAL_KEYS = ("gaps", "filled", "closed", "needs_operator", "licence", "hints_closed", "locked",
+              "lock_unavailable", "refresh_fetched", "refresh_written", "refused", "web_search_not_built")
+_ML = re.compile(r"^\s*(\d{1,5})\s*ml\s*$", re.IGNORECASE)
+_HREF = re.compile(r"""href=["']([^"'#]+)["']""", re.IGNORECASE)
+
+
+def enrich_mode() -> str:
+    return common.run_mode("ENABLE_KB_ENRICH_WORKER")
+
+
+def gap_fill_enabled() -> bool:
+    return common.house_flag("ENABLE_KB_GAP_FILL")
+
+
+def web_search_requested() -> bool:
+    return common.house_flag("ENABLE_KB_GAP_WEB_SEARCH")
+
+
+def _k(name, default, low, high):
+    return common.int_knob(name, default, low, high)
+
+
+def fetch_timeout() -> float:
+    return common.float_knob("KB_ENRICH_FETCH_TIMEOUT_SECONDS", 4.0, 1.0, 4.0)
+
+
+def _merchants(client: Any) -> List[Dict[str, Any]]:
+    from app.services import merchant_registry as _mr
+    rows: List[Dict[str, Any]] = []
+    for page in range(common.MAX_PAGES):
+        start = page * common.PAGE_SIZE
+        resp = (client.table(_mr.KB_MERCHANTS_TABLE).select(common.READ_COLUMNS + ",search_template")
+                .order("host").range(start, start + common.PAGE_SIZE - 1).execute())
+        data = getattr(resp, "data", None)
+        if not isinstance(data, list):
+            raise TypeError("kb_merchants page is not a list")
+        rows.extend(r for r in data if isinstance(r, dict))
+        if len(data) < common.PAGE_SIZE:
+            break
+    return rows
+
+
+def _products(client: Any, ids: List[str]) -> Dict[str, Dict[str, Any]]:
+    out: Dict[str, Dict[str, Any]] = {}
+    for i in range(0, len(ids), 100):
+        resp = client.table(common.KB_PRODUCTS_TABLE).select("id,brand,name").in_("id", ids[i:i + 100]).execute()
+        for r in getattr(resp, "data", None) or []:
+            if isinstance(r, dict) and r.get("id"):
+                out[r["id"]] = r
+    return out
+
+
+def _queue(client: Any, now) -> List[Tuple[str, List[str], int, str]]:
+    cut = (now - timedelta(days=_k("KB_ENRICH_DEMAND_DAYS", 7, 1, 30))).isoformat()
+    resp = (client.table(common.KB_GAPS_TABLE)
+            .select("product_key,field,demand_count,last_seen,state,source_hint")
+            .eq("state", "open").gte("last_seen", cut)
+            .order("demand_count", desc=True).order("last_seen", desc=True)
+            .limit(_k("KB_ENRICH_MAX_GAPS", 200, 1, 2000)).execute())
+    rows = [r for r in (getattr(resp, "data", None) or []) if isinstance(r, dict)
+            and not str(r.get("field") or "").startswith("pdp_")]
+    by: Dict[str, Dict[str, Any]] = {}
+    for r in rows:
+        e = by.setdefault(r["product_key"], {"fields": [], "demand": 0, "last": ""})
+        e["fields"].append(r["field"])
+        e["demand"] = max(e["demand"], int(r.get("demand_count") or 0))
+        e["last"] = max(e["last"], str(r.get("last_seen") or ""))
+    ranked = sorted(by.items(), key=lambda kv: (kv[1]["demand"], kv[1]["last"]), reverse=True)
+    return [(k, v["fields"], v["demand"], v["last"]) for k, v in ranked]
+
+
+class _Run:
+    def __init__(self, client, redis, now, web):
+        self.client, self.redis, self.now, self.web = client, redis, now, web
+        self.counts: Counter = Counter({k: 0 for k in TOTAL_KEYS})
+        self.writer = common.KbWriter(client)
+        self.run_id = uuid.uuid4().hex
+        self.fetcher = common.PoliteFetcher(require_tos=True)
+        self.web_logged = False
+
+    # -- single flight (fail-closed) --------------------------------------
+    def lock(self, pid: str) -> Optional[str]:
+        key = LOCK_PREFIX + hashlib.sha256(pid.encode("utf-8")).hexdigest()[:32]
+        if self.redis is None:
+            self.counts["lock_unavailable"] += 1
+            return None
+        try:
+            ok = self.redis.set(key, self.run_id, nx=True, ex=_k("KB_ENRICH_LOCK_SECONDS", 900, 60, 3600))
+        except Exception:  # noqa: BLE001 - fail closed
+            self.counts["lock_unavailable"] += 1
+            return None
+        if not ok:
+            self.counts["locked"] += 1
+            return None
+        return key
+
+    def release(self, key: str) -> None:
+        try:
+            held = self.redis.get(key)
+            if isinstance(held, bytes):
+                held = held.decode("utf-8", "replace")
+            if held == self.run_id:
+                self.redis.delete(key)
+        except Exception:  # noqa: BLE001 - the TTL expires it
+            pass
+
+    # -- fetch -------------------------------------------------------------
+    async def fetch(self, step: str, url: str, row: Any) -> Tuple[str, Any]:
+        host = (row or {}).get("host") or "-"
+        try:
+            res = await self.fetcher.get(url, row, self.now, timeout=fetch_timeout())
+        except Exception as exc:  # noqa: BLE001
+            outcome = "error:" + type(exc).__name__
+            logger.info("%s product step=%s host=%s outcome=%s", PREFIX, step, host, outcome)
+            return outcome, None
+        if res.refused == "gate":
+            outcome = "refused:" + str(res.gate)
+            self.counts["refused"] += 1
+        elif res.refused:
+            outcome = "refused:" + re.sub(r"[^a-z_]", "_", str(res.refused).lower())
+            self.counts["refused"] += 1
+        elif common.ok_status(res.status):
+            outcome = "ok"
+        else:
+            outcome = "error:http_status"
+        if outcome != "ok":
+            logger.info("%s product step=%s host=%s outcome=%s", PREFIX, step, host, outcome)
+        return outcome, res
+
+    # -- extraction to rows ------------------------------------------------
+    def extract(self, step: str, pid: str, product: Dict[str, Any], row: Dict[str, Any], res: Any,
+                url: str, variant_id: Optional[str] = None) -> set:
+        from app.services import jsonld_widen, kb_ingest, price_service
+        kb = common.kb_leaf()
+        host = row.get("host")
+        filled: set = set()
+        price = price_service.extract_price_from_html(
+            res.body, "%s %s" % (product.get("brand"), product.get("name")), common.row_currency(row), host,
+            url, category="fragrances", final_url=res.url)
+        market = str(row.get("country") or "").strip().upper()
+        if (not isinstance(price, dict) or not isinstance(price.get("amount"), (int, float))
+                or price.get("amount") <= 0 or price.get("estimated") is True
+                or kb_ingest.rung_for(price.get("source_method")) is None
+                or not re.match(r"^[A-Z]{2,3}$", market)):
+            logger.info("%s product step=%s host=%s outcome=empty", PREFIX, step, host)
+            return filled
+        conc = pid.split("|")[3]
+        conc = conc if conc in kb.kb_concentrations() else None
+        size_ml = None
+        m = _ML.match(str(price.get("size") or ""))
+        if m:
+            size_ml = int(m.group(1))
+        if variant_id is None:
+            variant_id = kb.kb_variant_key(pid, conc, size_ml)
+            self.writer.variants([kb.build_variant_row(id=variant_id, product_id=pid, updated_at=self.now,
+                                                       concentration=conc, size_ml=size_ml)])
+        else:
+            tail = variant_id.rsplit("|", 1)[-1]
+            size_ml = int(tail) if tail.isdigit() else None
+        stock = price.get("in_stock")
+        offer = kb.build_offer_row(
+            variant_id=variant_id, merchant_id=host, market=market, amount=price.get("amount"),
+            observed_currency=price.get("currency"), evidence_rung=kb_ingest.rung_for(price.get("source_method")),
+            canonical_url=kb.canonical_offer_url(res.url or url), captured_at=self.now, size_ml=size_ml,
+            in_stock=stock if isinstance(stock, bool) else None)
+        if offer is not None:
+            self.writer.offers([offer])
+            filled.add("price")
+            if step == "refresh":
+                self.counts["refresh_written"] += 1
+        if size_ml:
+            filled.add("size")
+        if conc:
+            filled.add("concentration")
+        image = price.get("image_url")
+        if isinstance(image, str) and jsonld_widen.allowed_image_url(
+                image, url, price_service.OFFICIAL_BRAND_DOMAINS) is not None:
+            img = kb.build_image_row(product_id=pid, url=image, provenance_host=host, source="retailer_jsonld",
+                                     captured_at=self.now)
+            if img is not None:
+                self.writer.upsert(kb_ingest.KB_IMAGES_TABLE, [img], "product_id,url")
+                filled.add("image")
+        logger.info("%s product step=%s host=%s outcome=%s", PREFIX, step, host, "filled" if filled else "empty")
+        return filled
+
+    # -- gap state CAS -----------------------------------------------------
+    def cas(self, pid: str, field: str, old: str, new: str) -> bool:
+        kb = common.kb_leaf()
+        if new not in kb.KB_GAP_STATES:
+            return False
+        resp = (self.client.table(common.KB_GAPS_TABLE).update({"state": new})
+                .eq("product_key", pid).eq("field", field).eq("state", old).execute())
+        return bool(getattr(resp, "data", None))
+
+    @staticmethod
+    def candidates(body: str, url: str) -> List[str]:
+        parts = urlsplit(url)
+        origin = parts.scheme + "://" + parts.netloc
+        out: List[str] = []
+        try:
+            data = json.loads(body)
+            for p in (((data.get("resources") or {}).get("results") or {}).get("products") or []):
+                if isinstance(p, dict) and isinstance(p.get("url"), str):
+                    out.append(urljoin(origin + "/", p["url"]))
+        except (ValueError, AttributeError, TypeError):
+            for href in _HREF.findall(body or ""):
+                full = urljoin(url, href)
+                fp = urlsplit(full)
+                if fp.netloc == parts.netloc and fp.path != parts.path:
+                    out.append(full)
+        seen, uniq = set(), []
+        for u in out:
+            if u not in seen:
+                seen.add(u)
+                uniq.append(u)
+        return uniq
+
+    async def ladder(self, pid, product, fields, rows, by_host):
+        for field in fields:
+            if field in LICENCE_GAP_FIELDS:
+                self.cas(pid, field, "open", "licence")
+                self.counts["licence"] += 1
+        want = [f for f in fields if f in FETCH_FIELDS]
+        if not want:
+            return
+        filled: set = set()
+        refusals: List[str] = []
+        search_rows = [r for r in rows if r.get("status") == "live" and r.get("search_template")
+                       and isinstance(r.get("tos"), dict) and r["tos"].get("verdict") == "allowed"]
+        search_rows.sort(key=lambda r: (str(r.get("country") or "") != "BH", str(r.get("host"))))
+        query = quote_plus("%s %s" % (product.get("brand"), product.get("name")))
+        for row in search_rows[:_k("KB_ENRICH_HOSTS_PER_GAP", 3, 1, 10)]:
+            if set(want) <= filled:
+                break
+            url = str(row["search_template"]).replace("{q}", query)
+            outcome, res = await self.fetch("search", url, row)
+            if outcome != "ok":
+                refusals.append(outcome)
+                continue
+            for cand in self.candidates(res.body, res.url or url)[:2]:
+                o2, r2 = await self.fetch("search", cand, row)
+                if o2 != "ok":
+                    refusals.append(o2)
+                    continue
+                filled |= self.extract("search", pid, product, row, r2, cand)
+                if set(want) <= filled:
+                    break
+        if not set(want) <= filled:
+            resp = (self.client.table(common.KB_GAPS_TABLE).select("product_key,field,state,source_hint")
+                    .eq("product_key", pid).eq("state", "queued").execute())
+            hints = [h for h in (getattr(resp, "data", None) or []) if isinstance(h, dict)
+                     and str(h.get("field") or "").startswith("pdp_")]
+            for hint in hints:
+                if set(want) <= filled:
+                    break
+                url = hint.get("source_hint")
+                row = common.merchant_for_host(by_host, urlsplit(str(url)).hostname)
+                outcome, res = await self.fetch("pdp_hint", url, row)
+                if outcome == "ok":
+                    filled |= self.extract("pdp_hint", pid, product, row, res, url)
+                    if self.cas(pid, hint["field"], "queued", "closed"):
+                        self.counts["hints_closed"] += 1
+                elif outcome == "refused:tos" or (outcome == "refused:not_live" and (row or {}).get("status") == "blocked"):
+                    refusals.append(outcome)
+                    self.cas(pid, hint["field"], "queued", "needs_operator")
+                else:
+                    refusals.append(outcome)
+        missing = [f for f in want if f not in filled]
+        if missing and self.web:
+            if not self.web_logged:
+                self.web_logged = True
+                self.counts["web_search_not_built"] = 1
+                logger.info("%s step=web_search status=not_built", PREFIX)
+        for f in want:
+            if f in filled:
+                self.counts["filled"] += 1
+                if self.cas(pid, f, "open", "closed"):
+                    self.counts["closed"] += 1
+        if missing and refusals and all(r in ("refused:tos", "refused:not_live") for r in refusals):
+            for f in missing:
+                if self.cas(pid, f, "open", "needs_operator"):
+                    self.counts["needs_operator"] += 1
+
+    async def gaps(self):
+        queue = _queue(self.client, self.now)
+        self.counts["gaps"] = sum(len(f) for _p, f, _d, _l in queue)
+        if not queue:
+            return
+        rows = _merchants(self.client)
+        by_host = common.rows_by_host(rows)
+        products = _products(self.client, [q[0] for q in queue])
+        for pid, fields, _d, _l in queue:
+            product = products.get(pid)
+            if product is None:
+                continue
+            key = self.lock(pid)
+            if key is None:
+                continue
+            try:
+                await self.ladder(pid, product, fields, rows, by_host)
+            finally:
+                self.release(key)
+
+    async def refresh(self):
+        cut = (self.now - timedelta(days=_k("KB_ENRICH_DEMAND_DAYS", 7, 1, 30))).isoformat()
+        resp = (self.client.table(common.KB_GAPS_TABLE).select("product_key,field,demand_count,last_seen,state")
+                .gte("last_seen", cut).execute())
+        demand: Dict[str, int] = {}
+        for r in getattr(resp, "data", None) or []:
+            if isinstance(r, dict) and not str(r.get("field") or "").startswith("pdp_"):
+                demand[r["product_key"]] = demand.get(r["product_key"], 0) + int(r.get("demand_count") or 0)
+        head = [p for p, _ in sorted(demand.items(), key=lambda kv: (-kv[1], kv[0]))][:_k("KB_ENRICH_HEAD_N", 50, 1, 1000)]
+        order = list(head)
+        if self.now.isoweekday() == _k("KB_ENRICH_TAIL_WEEKDAY", 7, 1, 7):
+            resp = self.client.table(common.KB_OFFERS_TABLE).select("variant_id,last_seen").execute()
+            latest: Dict[str, str] = {}
+            for r in getattr(resp, "data", None) or []:
+                vid = r.get("variant_id") if isinstance(r, dict) else None
+                if not isinstance(vid, str) or "|" not in vid:
+                    continue
+                pid = vid.rsplit("|", 1)[0]
+                latest[pid] = max(latest.get(pid, ""), str(r.get("last_seen") or ""))
+            tail = [p for p, _ in sorted(latest.items(), key=lambda kv: (kv[1], kv[0])) if p not in head]
+            order += tail[:_k("KB_ENRICH_TAIL_MAX", 500, 1, 5000)]
+        if not order:
+            return
+        rows = _merchants(self.client)
+        by_host = common.rows_by_host(rows)
+        products = _products(self.client, order)
+        cols = "variant_id,merchant_id,market,observed_currency,amount,canonical_url,last_seen,list_vs_sale"
+        for pid in order:
+            product = products.get(pid)
+            if product is None:
+                continue
+            key = self.lock(pid)
+            if key is None:
+                continue
+            try:
+                resp = self.client.table(common.KB_OFFERS_TABLE).select(cols).like("variant_id", pid + "|%").execute()
+                best: Dict[Tuple, Dict[str, Any]] = {}
+                for r in getattr(resp, "data", None) or []:
+                    k = (r.get("variant_id"), r.get("merchant_id"), r.get("market"), r.get("observed_currency"))
+                    if k not in best or str(r.get("last_seen")) > str(best[k].get("last_seen")):
+                        best[k] = r
+                for offer in best.values():
+                    row = common.merchant_for_host(by_host, offer.get("merchant_id"))
+                    url = offer.get("canonical_url")
+                    outcome, res = await self.fetch("refresh", url, row)
+                    if outcome != "ok":
+                        continue
+                    self.counts["refresh_fetched"] += 1
+                    self.extract("refresh", pid, product, row, res, url, variant_id=offer.get("variant_id"))
+            finally:
+                self.release(key)
+
+
+def _dry(client, now, legs, report_path) -> None:
+    queue = _queue(client, now) if "gaps" in legs else []
+    try:
+        from app.services import llm_spend_breaker as br
+        cap = float(br.cap_usd(br.LANE_OFFCLOCK))
+    except Exception:  # noqa: BLE001
+        cap = 0.0
+    report = {"queue": [{"product_key": p, "fields": f, "demand": d, "last_seen": ls} for p, f, d, ls in queue],
+              "plan": [{"product_key": p, "steps": ["search", "pdp_hint", "web_search", "operator"]} for p, _f, _d, _l in queue],
+              "refresh": {"legs": sorted(legs)},
+              "spend": {"lane": "offclock", "cap_usd": cap, "planned_usd": 0.0}}
+    logger.info("%s dry queue products=%d", PREFIX, len(queue))
+    logger.info("%s dry spend lane=offclock cap_usd=%.2f planned_usd=0.00", PREFIX, cap)
+    common.write_report(report_path, report)
+
+
+def main(argv: Optional[List[str]] = None, client: Any = None, redis: Any = None) -> int:
+    mode = enrich_mode()
+    if mode == common.MODE_OFF:
+        logger.info("%s mode=off ENABLE_KB_ENRICH_WORKER not set; skipping run", PREFIX)
+        return 0
+    p = argparse.ArgumentParser(prog="cron_kb_enrich")
+    p.add_argument("--dry-run", action="store_true")
+    p.add_argument("--report", default=None)
+    p.add_argument("--leg", choices=("all", "gaps", "refresh"), default="all")
+    args = p.parse_args(argv)
+    mode = common.cli_mode(mode, args.dry_run)
+    fill, web = gap_fill_enabled(), web_search_requested()
+    logger.info("%s mode=%s gap_fill=%d web_search=%d", PREFIX, mode, int(fill), int(web))
+    client = common.resolve_client(client, PREFIX)
+    if client is None:
+        return 0
+    legs = set()
+    if args.leg in ("all", "gaps") and fill:
+        legs.add("gaps")
+    if args.leg in ("all", "refresh"):
+        legs.add("refresh")
+    now = common._now()
+    if mode == common.MODE_DRY:
+        try:
+            _dry(client, now, legs, args.report)
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("%s dry failed (%s)", PREFIX, type(exc).__name__)
+        return 0
+    if redis is None:
+        try:
+            from app.services import cache_service
+            redis = cache_service.redis_client
+        except Exception:  # noqa: BLE001
+            redis = None
+    run = _Run(client, redis, now, web)
+
+    async def _go():
+        for leg in ("gaps", "refresh"):
+            if leg not in legs:
+                continue
+            try:
+                await getattr(run, leg)()
+            except Exception as exc:  # noqa: BLE001
+                logger.warning("%s leg %s failed (%s)", PREFIX, leg, type(exc).__name__)
+    asyncio.run(_go())
+    logger.info("%s totals %s", PREFIX, " ".join("%s=%d" % (k, run.counts[k]) for k in TOTAL_KEYS))
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
