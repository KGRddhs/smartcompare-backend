+
+@router.post("/kb/ingest", include_in_schema=False)
+@limiter.limit("30/minute")
+async def kb_operator_ingest(
+    request: Request,
+    body: kb_operator.OperatorIngest,
+    _gate=Depends(kb_operator.operator_gate),
+    _=Depends(verify_admin_key),
+):
+    if kb_operator.payload_too_large(body):
+        raise HTTPException(status_code=400, detail={"code": "KB_PAYLOAD_TOO_LARGE", "error": "The payload is too large."})
+    client = kb_operator._admin_client()
+    if client is None:
+        raise HTTPException(status_code=400, detail={"code": "KB_STORE_UNAVAILABLE", "error": "The KB store is unavailable."})
+    now = kb_operator._now()
+    try:
+        counts = await run_db(lambda: kb_operator.ingest(client, body, now))
+    except kb_operator.OperatorRefusal as refusal:
+        raise HTTPException(status_code=400, detail={"code": refusal.code, "error": refusal.message})
+    except Exception as exc:  # noqa: BLE001 - never a bare 503
+        logger.warning("[KB_OPERATOR] ingest failed (%s)", type(exc).__name__)
+        raise HTTPException(status_code=400, detail={"code": "KB_STORE_UNAVAILABLE", "error": "The KB store is unavailable."})
+    return {"success": True, "written": counts}
