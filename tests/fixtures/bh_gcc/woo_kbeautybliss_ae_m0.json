[{"id":31291,"name":"Shark\u2122 CryoGlow\u2122 Under-Eye Cooling + LED Anti-Aging Red Light &#038; Skin Clearing Mask","slug":"shark-cryoglow-under-eye-cooling-led-anti-aging-red-light-skin-clearing-mask","parent":0,"type":"simple","variation":"","permalink":"https:\/\/kbeautybliss.com\/product\/shark-cryoglow-under-eye-cooling-led-anti-aging-red-light-skin-clearing-mask\/","sku":"","short_description":"<p>A MedSpa-inspired mask that combines clinically-tested iQLED Technology\u2122 and InstaChill Technology to minimize the look of fine lines and blemishes.<\/p>","description":"<p>Introducing Shark CryoGlow Under-Eye Cooling &amp; LED Anti-Ageing &amp; Blemish Repair Mask. The UK\u2019s first LED light therapy mask to offer under-eye cooling technology. InstaChill Cold Technology helps soothe and depuff under-eyes in minutes. Better Ageing Mode is proven for more radiant, luminous skin in 4 weeks* &#8211; users saw an improvement in fine lines and a reduction in wrinkles*. Blemish Repair Mode is proven to improve blemishes and skin roughness in 4 weeks**. Developed with Dermatologists. Every skin type, any skin tone. *Results from 4-week clinical study with 59 subjects and 1x\/day use of pre-programmed 6-minute treatment. Individual results may vary. **Results from 4-week clinical study with 60 subjects and 1x\/day use of pre-programmed 8-minute treatment. Individual results may vary.<\/p>\n<p><strong>How to Use<\/strong><\/p>\n<ul>\n<li>Start with a clean, dry face. Put on mask and adjust straps for comfort.<\/li>\n<li>Turn on the mask by pressing and holding the remote\u2019s center dial.<\/li>\n<li>Select a routine and press &#8220;start.&#8221; Adjust InstaChill with the remote\u2019s chill button.<\/li>\n<li>After the session, remove the mask. It will power down automatically.<\/li>\n<li>Clean the mask with a cloth slightly dampened with water.<\/li>\n<\/ul>\n<p><strong>Get the Perfect Fit<\/strong><\/p>\n<ul>\n<li>Position the mask on your face, then stretch the back strap over your head so it sits on the crown. The top strap can be adjusted so the mask sits at your desired eye level.<\/li>\n<li>The mask\u2019s built-in chill pads should be positioned under the eyes. If the built-in chill pads do not touch your face, place the optional clip-on chill pads on the mask to achieve your best fit.<\/li>\n<\/ul>","on_sale":false,"prices":{"price":"2450","regular_price":"2450","sale_price":"2450","price_range":null,"currency_code":"AED","currency_symbol":"AED","currency_minor_unit":0,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"AED","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\">AED<\/span>2,450<\/span>","average_rating":"0","review_count":0,"images":[{"id":31292,"src":"https:\/\/kbeautybliss.com\/wp-content\/uploads\/2026\/06\/s2816189-main-zoom.webp","thumbnail":"https:\/\/kbeautybliss.com\/wp-content\/uploads\/2026\/06\/s2816189-main-zoom-400x400.webp","srcset":"https:\/\/kbeautybliss.com\/wp-content\/uploads\/2026\/06\/s2816189-main-zoom.webp 500w, https:\/\/kbeautybliss.com\/wp-content\/uploads\/2026\/06\/s2816189-main-zoom-300x300.webp 300w, https:\/\/kbeautybliss.com\/wp-content\/uploads\/2026\/06\/s2816189-main-zoom-150x150.webp 150w, https:\/\/kbeautybliss.com\/wp-content\/uploads\/2026\/06\/s2816189-main-zoom-400x400.webp 400w, https:\/\/kbeautybliss.com\/wp-content\/uploads\/2026\/06\/s2816189-main-zoom-100x100.webp 100w","sizes":"(max-width: 500px) 100vw, 500px","name":"s2816189-main-zoom","alt":""},{"id":31293,"src":"https:\/\/kbeautybliss.com\/wp-content\/uploads\/2026\/06\/71-hBNcGPbL._AC_SX679_.webp","thumbnail":"https:\/\/kbeautybliss.com\/wp-content\/uploads\/2026\/06\/71-hBNcGPbL._AC_SX679_-400x400.webp","srcset":"https:\/\/kbeautybliss.com\/wp-content\/uploads\/2026\/06\/71-hBNcGPbL._AC_SX679_.webp 679w, https:\/\/kbeautybliss.com\/wp-content\/uploads\/2026\/06\/71-hBNcGPbL._AC_SX679