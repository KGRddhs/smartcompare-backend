-up\/makeup-lips\/"}],"tags":[],"brands":[],"attributes":[],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":3,"stock_availability":{"text":"Only 3 left in stock","class":"in-stock wd-style-default"},"sold_individually":false,"weight":"0.020","dimensions":{"length":"","width":"","height":""},"formatted_weight":"0.02 kg","formatted_dimensions":"N\/A","add_to_cart":{"text":"Add to cart","description":"Add to cart: &ldquo;Uoga Uoga, Lip Scrub &#8211; Sugarmatcha (10 ml)&rdquo;","url":"\/wp-json\/wc\/store\/products?per_page=5&#038;page=1&#038;add-to-cart=102889","single_text":"Add to cart","minimum":1,"maximum":3,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/organature.bh\/wp-json\/wc\/store\/products\/102889","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/organature.bh\/wp-json\/wc\/store\/products"}],"related":[{"embeddable":true,"href":"https:\/\/organature.bh\/wp-json\/wc\/store\/products?related=102889&per_page=10"}]}},{"id":102884,"name":"Uoga Uoga, Extra  Lip Balm &#8211; Matchaberry (4 ml)","slug":"uoga-uoga-extra-lip-balm-matchaberry-4-ml","parent":0,"type":"simple","variation":"","permalink":"https:\/\/organature.bh\/product\/uoga-uoga-extra-lip-balm-matchaberry-4-ml\/","sku":"","short_description":"<ul>\n<li><strong>95%<\/strong>\u00a0agreed that the product made lips feel immediate softness after use*<\/li>\n<li><strong>90%<\/strong>\u00a0noticed that lips felt protected from harsh conditions e.g. frost, wind, snow, humidity, dry air*<\/li>\n<li><strong>90%<\/strong>\u00a0agreed that the product made lips feel restored after regular use*<\/li>\n<li>Matcha protects against oxidative stress<\/li>\n<li>Nourishing, moisturising and softening oils<\/li>\n<li>Refreshing aroma<\/li>\n<li>100% natural ingredients<\/li>\n<li>Vegan-friendly<\/li>\n<\/ul>","description":"<p>Known for its strong antioxidant properties, matcha helps protect lips against oxidative stress which can damage sensitive skin and cause dryness, reduced elasticity and premature ageing. Powdered Japanese tea can help fight these processes and ensure your lips stay soft and healthy.<\/p>\n<p>The oils we\u2019ve chosen are considered essential in lip care provided by natural cosmetics. A great moisturiser, avocado oil is also rich in fatty acids which support skin elasticity. Jojoba, castor and olive oils hydrate and moisturise, but absorb fast and do not feel heavy. Candelilla wax is a true vegan treasure which supports the much needed barrier against external stressors as well as helping the balm stay on for longer. Squalane encourages regeneration and protects against cracking, while vitamin E helps restore skin barrier.<\/p>\n<p>We\u2019ve created the scent for this balm with a cold and refreshing cup of matcha tea in mind. For this, we used lemon, mint and spearmint. The addition of powdered matcha is not only beneficial but gives this balm a lovely colour too.<\/p>\n<div class=\"panel panel-default\">\n<div id=\"collapseUsage\" class=\"panel-collapse collapse in\" role=\"tabpanel\" aria-labelledby=\"headingUsage\" aria-expanded=\"true\">\n<div class=\"panel-body\">\n<p>Store between +5 \u00b0C and +24 \u00b0C.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<div class=\"panel panel-default\">\n<div id=\"headingIngredients\" class=\"panel-heading\" role=\"tab\">\n<h4 class=\"panel-title\">Ingredients<\/h4>\n<div class=\"panel panel-default\">\n<div id=\"collapseIngredients\" class=\"panel-collapse collapse in\" role=\"tabpanel\" aria-labelledby=\"headingIngredients\" aria-expanded=\"true\">\n<div class=\"panel-body\">\n<p>Persea Gratissima (avocado) Oil*, Olea Europaea (olive) Fruit Oil*, Euphorbia Cerifera (candelilla) Wax, Simmondsia Chinensis (jojoba) Seed Oil*, Ricinus Communis (castor) Seed Oil*, Squalane (olive squalane), Hydrogenated Vegetable Oil, Camelia Sinensis (matcha) Powder*, Tocopherol (vitamin E), Helianthus Annuus (sunflower) Seed Oil, Citrus Limon (lemon) Peel Oil*, Mentha Arvensis (corn mint) Herb Oil*, Mentha Spicata (spearmint) Herb Oil*, Limonene**, Linalool**, Citral**, Carvone**. *From organic agriculture. **Naturally occurring in essential oils. 74% organic of total. 100% natural origin of total.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<div class=\"panel panel-default\">\n<div id=\"headingFitsTogether\" class=\"panel-heading\" role=\"tab\">\n<h4 class=\"panel-title\"><\/h4>\n<\/div>\n<\/div>\n<\/div>\n<\/div>","on_sale":false,"prices":{"price":"7000","regular_price":"7000","sale_price":"7000","price_range":null,"currency_code":"BHD","currency_symbol":"BHD","currency_minor_unit":3,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"","currency_suffix":" BHD"},"price_html":"<span class=\"woocommerce-Price-amount amount\"><bdi>7.000&nbsp;<span class=\"woocommerce-Price-currencySymbol\">BHD<\/span><\/bdi><\/span>","average_rating":"0","review_count":0,"images":[{"id":102885,"src":"https:\/\/organature.bh\/wp-content\/uploads\/2026\/06\/Untitled-design-2026-06-16T193340.474.png","thumbnail":"https:\/\/organature.bh\/wp-content\/uploads\/2026\/06\/Untitled-design-2026-06-16T193340.474-600x600.png","srcset":"https:\/\/organature.bh\/wp-content\/uploads\/2026\/06\/Untitled-design-2026-06-16T193340.474.png 2000w, https:\/\/organature.bh\/wp-content\/uploads\/2026\/06\/Untitled-design-2026-06-16T193340.474-300x300.png 300w, https:\/\/organature.bh\/wp-content\/uploads\/2026\/06\/Untitled-design-2026-06-16T193340.474-1024x1024.png 1024w, https:\/\/organature.bh\/wp-content\/uploads\/2026\/06\/Untitled-design-2026-06-16T193340.474-150x150.png 150w, https:\/\/organature.bh\/wp-content\/uploads\/2026\/06\/Untitled-design-2026-06-16T193340.474-768x768.png 768w, https:\/\/organature.bh\/wp-content\/uploads\/2026\/06\/Untitled-design-2026-06-16T193340.474-1536x1536.png 1536w, https:\/\/organature.bh\/wp-content\/uploads\/2026\/0