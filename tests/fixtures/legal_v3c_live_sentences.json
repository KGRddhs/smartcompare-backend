   "section": "front",
   "kind": "ADAPTED",
   "text": "**\u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0641\u064a {date}:** \u0623\u0636\u0641\u0646\u0627 Anthropic \u0625\u0644\u0649 \u0645\u0632\u0648\u0651\u062f\u064a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u062f\u064a\u0646\u0627 (\u0627\u0644\u0642\u0633\u0645 4)\u060c \u0648\u0633\u064a\u0637\u0644\u0628 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0625\u0630\u0646\u0643 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0644\u0625\u0631\u0633\u0627\u0644 \u0637\u0644\u0628\u0627\u062a\u0643 \u0625\u0644\u0649 \u0645\u0632\u0648\u0651\u062f\u064a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u062f\u064a\u0646\u0627.",
   "date_key": "AI_SWITCH_DATE_AR"
  },
  {
   "id": "N2",
   "lang": "ar",
   "file": "app/legal/terms_of_service_ar.md",
   "section": "front",
   "kind": "ADAPTED",
   "text": "**\u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0641\u064a {date}:** \u0623\u0636\u0641\u0646\u0627 Anthropic \u0625\u0644\u0649 \u0645\u0632\u0648\u0651\u062f\u064a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u062f\u064a\u0646\u0627 (\u0627\u0644\u0642\u0633\u0645 8)\u060c \u0648\u0633\u064a\u0637\u0644\u0628 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0625\u0630\u0646\u0643 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0644\u0625\u0631\u0633\u0627\u0644 \u0637\u0644\u0628\u0627\u062a\u0643 \u0625\u0644\u0649 \u0645\u0632\u0648\u0651\u062f\u064a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u062f\u064a\u0646\u0627.",
   "date_key": "AI_SWITCH_DATE_AR"
  },
  {
   "id": "D3",
   "lang": "ar",
   "file": "app/legal/terms_of_service_ar.md",
   "section": "6",
   "kind": "NEW",
   "text": "\u0648\u0642\u0628\u0644 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0645\u0627 \u064a\u0647\u0645\u0651\u0643\u060c \u062a\u062d\u0642\u0651\u0642 \u0645\u0646\u0647 \u0628\u0627\u0644\u0631\u062c\u0648\u0639 \u0625\u0644\u0649 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u0642\u062f\u0651\u0645\u0647\u0627 \u0627\u0644\u0645\u062a\u062c\u0631 \u0623\u0648 \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u0645\u0635\u0646\u0651\u0639\u0629.",
   "after": "\u062a\u064f\u0646\u0634\u0623 \u062e\u0644\u0627\u0635\u0627\u062a \u0627\u0644\u0645\u0642\u0627\u0631\u0646\u0629 \u0648\u0627\u0644\u0645\u0644\u062e\u0635\u0627\u062a \u0648\u0627\u0644\u0645\u0648\u0627\u0635\u0641\u0627\u062a \u0648\u0627\u0644\u062a\u0648\u0635\u064a\u0627\u062a \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0645\u0646 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0627\u0645\u0629\u060c \u0648\u0642\u062f \u062a\u0643\u0648\u0646 \u0646\u0627\u0642\u0635\u0629 \u0623\u0648 \u063a\u064a\u0631 \u0635\u062d\u064a\u062d\u0629 \u0623\u0648 \u063a\u064a\u0631 \u0645\u062d\u062f\u0651\u062b\u0629.",
   "before": "\u0648\u062a\u0623\u062a\u064a \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0648\u0627\u0644\u062a\u0648\u0641\u0631 \u0648\u0627\u0644\u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0645\u0646 \u0645\u0635\u0627\u062f\u0631 \u062a\u0627\u0628\u0639\u0629 \u0644\u0623\u0637\u0631\u0627\u0641 \u062b\u0627\u0644\u062b\u0629\u060c \u0648\u0642\u062f \u062a\u062a\u063a\u064a\u0631 \u0623\u0648 \u062a\u062e\u062a\u0644\u0641 \u0644\u062f\u0649 \u0627\u0644\u0645\u062a\u062c\u0631\u061b \u0648\u0642\u062f \u062a\u0643\u0648\u0646 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0645\u062d\u0648\u0651\u0644\u0629 \u0645\u0646 \u0639\u0645\u0644\u0629 \u0623\u062e\u0631\u0649\u060c \u0648\u0642\u062f \u0644\u0627 \u062a\u0634\u0645\u0644 \u0631\u0633\u0648\u0645 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0623\u0648 \u0627\u0644\u062c\u0645\u0627\u0631\u0643 \u0623\u0648 \u0627\u0644\u0636\u0631\u0627\u0626\u0628."
