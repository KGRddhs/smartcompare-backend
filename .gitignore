venv/
.venv/

# Poetry
poetry.lock

# IDE
.idea/
.vscode/

# Temp
temp_uploads/
*.log

# OS
.DS_Store
Thumbs.db

# Debug/test artifacts (root only)
response_*.json
/test_*.py
/extract_*.py
import_batches/
nul

# Test images (root only)
/test_*.jpg
/test_*.png

# Expo
.expo/

# Git worktrees (project-local isolated workspaces)
.worktrees/

# Survey raw data (contains email/phone PII in last 2 columns)
# Only the generated cohort_priors.json is committed
data/surveys/*.csv

# Agent intermediate drafts (e.g. ar-proofread.diff awaiting review)
.drafts/

# I4 shadow harness working artifacts: L2 dump, reconstructed verdict inputs,
# per-arm result JSON. Regenerable from L2 via scripts/shadow_experiments.py.
.shadow/

# Session QA / recon / agent scratch. NEVER track — recon dumps can contain live
# tokens (e.g. .qa-bh-sourcing/_f3_nasser_main.js carries a scraped guest token).
# Whole-branch review #4 (bh-source-intelligence) flagged this as a latent
# git-add-A leak vector; gitignoring fail-closes it.
.qa-*/
.agents/
.codex/
