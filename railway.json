{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "exec uvicorn app.main:app --host 0.0.0.0 --port $PORT --timeout-graceful-shutdown 20 --limit-concurrency \"${UVICORN_LIMIT_CONCURRENCY:-512}\"",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "drainingSeconds": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
