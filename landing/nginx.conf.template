# Qaren landing-page nginx config (template form).
# envsubst renders ${PORT} from environment at container boot per
# nginx:alpine docker-entrypoint.sh behavior.

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Default Content-Type for HTML; .well-known files override below.
    default_type text/html;

    # Apple Universal Links AASA — NO file extension, must be application/json.
    location = /.well-known/apple-app-site-association {
        default_type application/json;
        add_header Cache-Control "public, max-age=3600, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Android App Links assetlinks — application/json (Google convention).
    location = /.well-known/assetlinks.json {
        default_type application/json;
        add_header Cache-Control "public, max-age=3600, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # /support → /support.html clean URL (matches Vercel cleanUrls behavior).
    # Why no HTTP redirect to mailto: — 301/302 to mailto: scheme is broken
    # cross-browser (Firefox rejects, Chrome+Safari inconsistent). support.html
    # ships meta-refresh + visible CTA button as the working fallback.
    location = /support {
        try_files /support.html =404;
    }

    # /ar/support → /ar/support.html clean URL (same rationale as /support above).
    # /ar/{index,privacy,terms}.html paths are handled by the catch-all
    # location / try_files chain below — only the extension-less /ar/support
    # needs an explicit rule.
    location = /ar/support {
        try_files /ar/support.html =404;
    }

    # /bot -> the crawler info page (session 76, DG4). The named User-Agent our
    # robots.txt reads send (app/services/sitemap_discovery_service.py _ROBOTS_UA,
    # mirrored by scripts/resolve_search_descriptors.py USER_AGENT) points here.
    location = /bot {
        try_files /bot/index.html =404;
    }

    # Global security headers — matches vercel.json.alternative + iOS WKWebView
    # expectations.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Universal-link hand-off (session 69, audit RT-8 / EXPO-06). /c/<share token>,
    # /r/<invite code> and /q/<quiz token> are the three path families the app
    # registers as universal links (the AASA above) and as qaren:// deep links.
    # A browser reaches these paths from a pasted or forwarded link, an in-app
    # browser, Android (the assetlinks certificate is still a placeholder) or a
    # phone without the app - and only once getmyez.com points at this service
    # (on 2026-10-10 it still served an unrelated page). open.html offers the
    # qaren:// hand-off (and the store link once it exists) instead of the 404
    # the catch-all used to return.
    location ^~ /c/ {
        try_files /open.html =404;
    }
    location ^~ /r/ {
        try_files /open.html =404;
    }
    location ^~ /q/ {
        try_files /open.html =404;
    }

    # All other paths: serve from root.
    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    # Health check endpoint for Railway monitoring.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        default_type text/plain;
    }

    # Don't log favicon 404 spam if asset is missing during A5-blocked window.
    location = /favicon.png {
        log_not_found off;
        access_log off;
        try_files $uri =404;
    }
}

# www.getmyez.com -> the apex (session 76, DG3). Universal links and the AASA are
# claimed for the apex only, so www answers a permanent redirect and serves nothing
# itself. Keep this block AFTER the catch-all server above: nginx's default server
# for a listen socket is the first block that declares it, and every other Host
# (the Railway host, the apex) must keep reaching the catch-all.
server {
    listen ${PORT};
    server_name www.getmyez.com;
    return 301 https://getmyez.com$request_uri;
}
